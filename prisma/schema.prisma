generator client {
  provider = "prisma-client-js"
  // Generate into the source tree so Vercel never serves a stale @prisma/client
  // from a cached node_modules between deploys. (Default node_modules/.prisma/
  // path was being cached across deploys, missing newly-added models.)
  output   = "../src/generated/prisma"
}

// Prisma 7 moved connection URLs out of the schema. The runtime client connects
// via the pg driver adapter (see src/lib/prisma.ts, using DATABASE_URL);
// migrations/introspection read DIRECT_URL from prisma.config.ts.
datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  TRAINER
  CLIENT
  ADMIN
}

// A person's role *within a business* (distinct from the app-level Role above —
// every member is a TRAINER at the User level). OWNER is the founding account
// that holds billing; MANAGER has full operational access but not billing;
// STAFF sees only what's assigned to them. The role seeds a default permission
// set which the owner can then override per-member via TrainerMembership.permissions.
enum CompanyRole {
  OWNER
  MANAGER
  STAFF
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
}

enum ShareType {
  READ_ONLY
  CO_MANAGE
  TRANSFER
}

enum SessionType {
  IN_PERSON
  VIRTUAL
}

enum SessionStatus {
  UPCOMING
  COMPLETED
  COMMENTED
  INVOICED
}

// When a piece of homework is any use to the client.
//
// Most homework is PRACTICE and only makes sense once the session has happened
// — that is the default, and what every row written before this existed is.
// Some homework is PREPARATION ("bring a hungry dog and a pot of chicken"),
// which is worthless if it arrives after the class, so it has to be readable
// the moment the trainer hands it out.
//
// The flag is set once on the offering (PackageDefaultTask) and copied onto
// each TrainingTask at hand-out, like every other field there — homework is a
// snapshot, so re-flagging the offering never rewrites work already given out.
enum HomeworkTiming {
  BEFORE_SESSION
  AFTER_SESSION
}

enum AttachmentKind {
  IMAGE
  VIDEO
}

enum MessageChannel {
  TRAINER_CLIENT // visible to client
  TRAINER_TRAINER // private between trainers
}

enum CustomFieldType {
  TEXT
  NUMBER
  DROPDOWN
}

enum ProductKind {
  PHYSICAL
  DIGITAL
}

enum ProductRequestStatus {
  PENDING // client wants this, hasn't been delivered yet
  FULFILLED // trainer marked it delivered (linked to a session)
  CANCELLED // client withdrew the request, or trainer dismissed it
}

// ─── Core User ───────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  // NULL when the person has no email address — a groomer's book is full of
  // people known only by a mobile number. It used to be mandatory, so those
  // clients were given a synthetic address on a domain with no MX record; that
  // made every one of them look mailable, and only a guard in sendEmail stopped
  // 550 guaranteed hard bounces. NULL says the true thing instead.
  //
  // Postgres allows many NULLs in a UNIQUE index, so uniqueness still holds for
  // everyone who HAS an address. A user with no email simply cannot sign in —
  // which was already true of every one of them, none having a login row.
  email         String?   @unique
  name          String?
  // Defaults to TRAINER so PrismaAdapter can create rows for OAuth (Apple/Google)
  // sign-ins which don't supply a role. Existing flows (Credentials sign-up,
  // invite acceptance) set role explicitly and override the default.
  role          Role      @default(TRAINER)
  emailVerified DateTime?
  image         String?
  timezone      String    @default("Pacific/Auckland")

  notifyEmail        Boolean @default(true)
  notifyPush         Boolean @default(true)
  // Which page a trainer lands on when they open the app: "dashboard" (default)
  // or "schedule". Personal per-user preference, honoured by the root redirect.
  landingPage        String  @default("dashboard")
  // Opt-out of PupManager product-update ("what's new") announcement EMAILS.
  // Universal to any user (trainer or client); set via the email unsubscribe
  // link. The in-app bell announcement is never suppressed by this.
  productEmailOptOut Boolean @default(false)
  // Show the one-line "what this page is" helper text under each page's title.
  // On by default for newcomers; trainers can turn it off in Settings once the
  // app is familiar.
  // showPageHelp was the "Show page descriptions" switch. The descriptions
  // and the setting came out on 2026-08-02; the COLUMN stays until this is
  // deployed, because a rolling deploy briefly runs the old code, and the
  // old code selects it. Safe to drop in a later release.
  showPageHelp       Boolean @default(true)

  // Soft delete. When set, the account is "deactivated" — blocked from signing
  // in — but all its data is retained. Admins deactivate/reactivate from
  // /admin/trainers; we never hard-delete trainer accounts.
  deactivatedAt DateTime?

  // Timestamp of the most recent successful sign-in (any provider). Updated by
  // the NextAuth signIn event. Null = never signed in since this was added.
  // Surfaced in the admin trainers table as "Last seen".
  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Auth
  accounts Account[]
  sessions Session[]

  // Role-specific profiles
  trainerProfile TrainerProfile?
  clientProfiles ClientProfile[]

  // Businesses this user belongs to as a trainer. The OWNER of a business has
  // both a trainerProfile (the business itself) AND an OWNER membership row;
  // invited members have only a membership (no trainerProfile of their own).
  // One membership per business — see TrainerMembership @@unique.
  memberships TrainerMembership[]

  // Messages sent by this user
  sentMessages        Message[]
  groupParticipations MessageGroupParticipant[]
  groupMessages       GroupMessage[]

  // Push notification device tokens (one user can have multiple devices)
  deviceTokens DeviceToken[]

  // Per-(type, channel) preferences. Absence of a row means "use the default".
  notificationPreferences NotificationPreference[]

  // Dashboard scratchpad: one freeform brain-dump per (company, user), and the
  // to-do items this user created.
  brainDumps   TrainerBrainDump[]
  createdTodos TrainerTodo[]      @relation("TodoCreatedBy")

  // "Not now" choices on add-on nudges, remembered across devices.
  nudgeDismissals NudgeDismissal[]

  // Stock the person themselves moved — a delivery booked in, a write-off.
  stockMovements StockMovement[]

  @@map("users")
}

// A "Not now" on an add-on nudge. Previously this lived only in localStorage,
// so the nudge reappeared on every other browser and device the trainer used.
// Scoped per USER (not per company) to match that per-person meaning: a staff
// member dismissing a nudge shouldn't silence it for the owner.
model NudgeDismissal {
  id          String   @id @default(cuid())
  userId      String
  // The call site's stable nudge key, e.g. "finances-payments" or
  // "dashboard-xero" — same string the localStorage key used.
  nudgeId     String
  dismissedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, nudgeId])
  @@index([userId])
  @@map("nudge_dismissals")
}

enum DevicePlatform {
  IOS
  ANDROID
}

// What kind of event a notification is for. Add new variants as we wire up
// more triggers — the preference matrix UI renders one row per type.
enum NotificationType {
  SESSION_REMINDER // n minutes before a TrainingSession starts
  SESSION_NOTES_REMINDER // n minutes before a TrainingSession ends — prompts the trainer to write session notes
  NEW_CLIENT_INVITE_ACCEPTED // a client used the invite link to sign up
  CLIENT_COMPLETED_TASKS // a client completed all of today's tasks
  CLIENT_LOGGED_TRAINING // a client logged a practice against a homework task
  CLIENT_BOOKED_SESSION // a client self-booked a session or enrolled in a class
  CLIENT_CANCELLED_SESSION // a client cancelled a booking or enrolment
  CLIENT_SHOP_ORDER // a client bought or requested a shop product
  NEW_MESSAGE // a new in-app message landed
  NEW_ENQUIRY // a public form (embed or intake) submission landed
  ENQUIRY_FOLLOWUP_REMINDER // a NEW enquiry has gone unanswered — nudges at 6/18/24/36h
  DAILY_SUMMARY // morning digest of today's sessions/tasks
  WEEKLY_SUMMARY // Sunday-evening wrap of the week + week-ahead glance
  STREAK_UPDATE // daily nudge about the trainer's weekly engagement streak
  PLATFORM_ANNOUNCEMENT // a product update / "what's new" broadcast from PupManager
  // ─── Client-facing (the dog owner) ───
  CLIENT_ADDED_TO_PLAN // trainer added the client to a session / package / class
  CLIENT_SESSION_DIGEST // morning summary of the day's sessions
  CLIENT_SESSION_REMINDER // a heads-up n minutes before each session
  CLIENT_SESSION_CHANGED // a session was rescheduled or cancelled
  CLIENT_RECAP_READY // the trainer posted the write-up for a session
  CLIENT_NEW_MESSAGE // the trainer sent the client a message
  TRAINER_COMMENTED_LOG // the trainer replied to the client's practice log
  CLIENT_PAYMENT_REQUEST // the trainer is asking the client to pay an invoice now
  // Deliberately NOT CLIENT_ADDED_TO_PLAN, whose copy is "you're booked in":
  // an invitation means a package is now OPEN to them, not that they are on it.
  // Telling someone they have joined something they have not paid for is worse
  // than having one more enum value.
  CLIENT_MEMBERSHIP_INVITE // the trainer opened a restricted package to this client
}

enum NotificationChannel {
  PUSH
  EMAIL
  IN_APP // shows in the client's notifications feed
}

enum AnnouncementStatus {
  DRAFT // authored in the admin area, not yet broadcast
  SENT // fanned out to recipients' notification feeds
}

enum AnnouncementAudience {
  ALL_TRAINERS // every accepted trainer-side team member (owners + staff)
  ALL_CLIENTS // every client (dog owner) with an account, excluding sample previews
  EVERYONE // trainers + clients, de-duplicated across roles
}

// A platform "what's new" update authored by a super-admin (Karl) and broadcast
// to trainers' notification bells. This row is the editable source of truth /
// history; sending fans out one Notification row per recipient User (the bell
// reads Notification, not this table). See src/app/api/admin/announcements.
model Announcement {
  id                  String               @id @default(cuid())
  title               String
  body                String               @db.Text
  // Optional in-app deep link the bell card routes to (e.g. "/settings?tab=addons").
  link                String?
  status              AnnouncementStatus   @default(DRAFT)
  audience            AnnouncementAudience @default(ALL_TRAINERS)
  // The admin User who authored it (kept for the history list). Null = legacy.
  createdById         String?
  // Set when broadcast; recipientCount records how many feeds it reached.
  sentAt              DateTime?
  recipientCount      Int?
  // Optional email version: when sendEmail is on, the same broadcast also emails
  // the audience. emailHtml is the serialized rich-builder body; emailSubject
  // defaults to the title. emailRecipientCount records how many emails went out.
  sendEmail           Boolean              @default(false)
  emailSubject        String?
  emailHtml           String?              @db.Text
  emailRecipientCount Int?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([status, createdAt])
  @@map("announcements")
}

// Internal (super-admin) diary note about a trainer business — for the PupManager
// team to track a trainer's progress. Not visible to the trainer. trainerId is a
// TrainerProfile.id (loosely coupled, admin-only).
model AdminTrainerNote {
  id          String   @id @default(cuid())
  trainerId   String
  body        String   @db.Text
  createdById String? // admin User who wrote it
  createdAt   DateTime @default(now())

  @@index([trainerId, createdAt])
  @@map("admin_trainer_notes")
}

// Internal (super-admin) to-do against a trainer business.
model AdminTrainerTask {
  id          String    @id @default(cuid())
  trainerId   String
  title       String
  done        Boolean   @default(false)
  createdById String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([trainerId, done, createdAt])
  @@map("admin_trainer_tasks")
}

// Per-(user, type, channel) preference. Absence of a row means "use the
// type's default" (typically enabled). `minutesBefore` is only meaningful for
// time-relative types like SESSION_REMINDER; null otherwise.
model NotificationPreference {
  id            String              @id @default(cuid())
  userId        String
  // The organisation this preference applies to, for trainers who belong to
  // more than one. Null = the user's global/default row (also what every
  // pre-multi-org row is): the fallback when no per-org override exists, and
  // the only row client-audience prefs ever use.
  companyId     String?
  type          NotificationType
  channel       NotificationChannel
  enabled       Boolean             @default(true)
  // Time-relative (e.g. SESSION_REMINDER) — minutes before the event fires.
  minutesBefore Int?
  // Like minutesBefore but allows MULTIPLE lead times (e.g. client picks
  // "1 day before" + "2 hours before"). Empty = fall back to minutesBefore.
  leadMinutes   Int[]               @default([])
  // Time-of-day (e.g. DAILY_SUMMARY) — hour 0–23 in the user's timezone.
  dailyAtHour   Int?
  // Optional per-user copy overrides. Support {{placeholders}} that the
  // sender substitutes (e.g. {{dogName}}, {{startTime}}, {{count}}). Null
  // values fall back to the type's default template.
  customTitle   String?
  // Body override. For EMAIL-channel rows this may hold sanitized rich-text
  // HTML (authored in the editor); PUSH-channel rows stay plain text. Senders
  // convert HTML→text for push. @db.Text to fit formatted markup.
  customBody    String?             @db.Text
  // For DAILY_SUMMARY: when the trainer has zero sessions booked, swap
  // the morning digest for a warm "you can take the day off" message
  // instead of "0 sessions today" copy. Default true so existing
  // trainers get the friendlier behaviour without opting in.
  dayOffSummary Boolean             @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId, type, channel])
  @@index([userId])
  @@map("notification_preferences")
}

model DeviceToken {
  id         String         @id @default(cuid())
  userId     String
  token      String         @unique
  platform   DevicePlatform
  createdAt  DateTime       @default(now())
  lastSeenAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// ─── NextAuth Models ─────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Trainer Profile ─────────────────────────────────────────────────────────

model TrainerProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  businessName       String
  // URL-safe handle for the public branded client-login page
  // (app.pupmanager.com/c/<slug>). Generated from businessName on demand,
  // editable in settings. Nullable until first generated.
  slug               String?  @unique
  // The trainer's phone number — always on file (required at signup, enforced by
  // the (trainer) layout gate). Shown to clients (my-help page + in-app "Call"
  // button) ONLY when showPhoneToClients is true.
  phone              String?
  // Opt-in: whether `phone` is shown to clients. Default false = private (kept
  // for PupManager/ops only); the trainer ticks a box to publish it. Backfilled
  // true for accounts that had a phone before this flag existed, to preserve
  // their prior always-shown behaviour.
  showPhoneToClients Boolean  @default(false)
  // What this business actually does — persona ids from the onboarding wizard
  // ("walker" | "trainer" | "behaviourist" | "groomer" | "petsitter"). Drives
  // which schedule "add" options show (a groomer never runs group walks or
  // classes). Empty = unknown → show everything (backward-compatible for
  // accounts that predate this capture).
  businessRoles      String[] @default([])
  // Feature toggles set during onboarding (and editable in Settings). Not every
  // trainer runs classes, records notes, or wants a client-facing app — these
  // gate those surfaces. Default on so existing accounts are unaffected.
  clientAppEnabled   Boolean  @default(true)
  classesEnabled     Boolean  @default(true)
  notesEnabled       Boolean  @default(true)
  // Team emails captured during onboarding but NOT yet invited — the owner
  // sends them from the dashboard once they've set things up, so staff don't
  // open a blank system. Cleared when the invites are actually sent.
  pendingTeamInvites String[] @default([])
  logoUrl            String?
  iconUrl            String? // square brand icon / app mark (logoUrl is the wide wordmark)
  website            String? // public website URL, shown to clients as a link in the app header
  publicEmail        String? // public contact email shown to clients (may differ from login email)
  inviteTemplate     String?  @db.Text // customisable invite email template
  // Brand colour — drives the client-app accent AND the accent strip on
  // outbound emails. Falls back to PupManager teal (#2a9da9).
  emailAccentColor   String?
  // Photo behind the top of the TRAINER's home screen, and whether the business
  // lockup — the logo AND the greeting line under it — sits over it. On this
  // row rather than the membership on purpose: TrainerProfile.id IS the company
  // id, so a business with five staff has one home screen, as asked for.
  homeHeroImageUrl   String?  @db.Text
  homeHeroShowLockup Boolean  @default(true)
  // Short personal welcome shown to clients on their app home (set in the
  // first-run personalization wizard, editable later in settings).
  clientWelcomeNote  String?  @db.Text

  // Google Calendar integration
  googleCalendarRefreshToken String? @db.Text
  googleCalendarConnected    Boolean @default(false)

  // Schedule view preferences — controls the visible hour range and which
  // weekdays render in the week grid. Days are 1=Mon..7=Sun.
  // The base scheduleStart/EndHour pair drives the desktop grid; the
  // mobile pair (nullable) overrides on phones so trainers can run a
  // tighter window on small screens. Null = fall back to the base pair.
  scheduleStartHour         Int     @default(7) // inclusive
  scheduleEndHour           Int     @default(21) // exclusive (last hour shown is end-1)
  scheduleMobileStartHour   Int? // mobile-only override; null falls back to scheduleStartHour
  scheduleMobileEndHour     Int? // mobile-only override; null falls back to scheduleEndHour
  scheduleDays              Json    @default("[1,2,3,4,5,6,7]")
  // Which grid layout the trainer last chose — "day" | "threeDay" | "week".
  // Same desktop/mobile split as the hours above: a phone wants a day column
  // where a desktop wants the week, so remembering ONE value would fight the
  // trainer on whichever device they used second. Null = the old default
  // (week on desktop, day on a phone).
  scheduleView              String?
  scheduleMobileView        String?
  // Up to 2 extra fields rendered on schedule blocks. Allowed ids:
  // "location" | "description" | "sessionType" | "duration" | "title"
  scheduleExtraFields       Json    @default("[]")
  // Ordered list of intake-form section names (string[]). Lets trainers create
  // empty sections and drag fields into them; without this, a section only
  // "existed" if at least one field had that category. Fields whose category
  // doesn't appear in this list pile into a "Fields without a section" bucket.
  intakeSectionOrder        Json    @default("[]")
  // Whether the intake form is published (visible to clients). Defaults to
  // false so newly-seeded intake fields don't go live until the trainer
  // explicitly publishes from the intake editor.
  intakeFormPublished       Boolean @default(false)
  // Per-trainer assignment of the three core "system" intake fields
  // (name, email, phone) to a section in intakeSectionOrder. Shape:
  // { name?: string|null, email?: string|null, phone?: string|null }.
  // null/missing for any key = orphan (renders alongside fields that
  // also lack a section). Stored separately from CustomField.category
  // because the system fields aren't custom fields — they back real
  // columns on User/ClientProfile.
  intakeSystemFieldSections Json    @default("{}")
  // Per-company config for the built-in client/dog fields when CREATING a
  // client (the full create form + the quick-add contact form). Shape:
  // { "<fieldKey>": { required?: boolean, quickAdd?: boolean } } where fieldKey
  // is one of name|email|phone|address|dogName|dogBreed|dogWeight|dogDob|dogNotes.
  // `required` = required in the full create form; `quickAdd` = shown in (and
  // required for) the quick-add form. Missing keys fall back to the defaults in
  // src/lib/client-fields.ts. Custom fields carry their own required/inQuickAdd.
  clientFieldConfig         Json    @default("{}")
  // Trainer-chosen visible columns on /clients. Allowed ids:
  // "email" | "dog" | "breed" | "extraDogs" | "nextSession" | "compliance" | "shared" | "custom:<id>"
  clientListColumns         Json    @default("[\"email\",\"dog\",\"nextSession\",\"compliance\"]")
  // Grouping for /clients. null = flat list. "nextDay" = group by day of
  // next booking. "custom:<id>" = group by custom-field value.
  clientListGroupBy         String?

  // Subscription
  subscriptionPlanId   String?
  subscriptionStatus   SubscriptionStatus @default(TRIALING)
  // When the free trial expires. Stamped on signup (now + 14 days). Null
  // for paid plans that don't have a trial window or trainers who never
  // had one (legacy accounts).
  trialEndsAt          DateTime?
  // Stripe identifiers — populated lazily, the first time the trainer
  // hits Checkout. Customer is reused across plan changes; subscription
  // and price flip when they upgrade/downgrade.
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  // End of the current paid period — drives the "renews on …" copy and
  // the access-cutoff job for cancelled subscriptions.
  currentPeriodEnd     DateTime?
  // Admin-granted grace period. When set and in the future, the trainer
  // keeps full platform access regardless of trial/subscription state —
  // an escape hatch for comped accounts, support cases, or payment hiccups.
  // Set per-trainer from /admin/trainers. Null = no grace.
  gracePeriodUntil     DateTime?
  // Dual-mode billing: when true this trainer bills against Stripe TEST mode
  // (sandbox) — the test secret key + the *Test price columns — so the demo
  // account can show the full billing flow without ever taking a real charge
  // while everyone else is on live Stripe.
  sandboxBilling       Boolean            @default(false)
  // Internal/test account flag. When true this is a PupManager-owned account
  // (our own testing/demo logins), not a real customer. Set from
  // /admin/trainers so we can visually tag — and later exclude from metrics —
  // accounts that are "ours".
  isInternal           Boolean            @default(false)
  // ISO 3166-1 alpha-2 country code captured from the signup request's IP geo
  // (Vercel's x-vercel-ip-country) at account creation. Null for older accounts
  // / signups without geo. Surfaced as a flag in /admin/trainers.
  signupCountry        String?
  // First time this business became a PAYING customer (subscription went
  // ACTIVE — i.e. money actually moved, not merely "started a plan while still
  // inside the carried-over trial"). Set once and never cleared, so it doubles
  // as the idempotency guard for the internal "someone converted" alert:
  // Stripe fires customer.subscription.updated often and retries webhooks, and
  // we only want to be told once.
  convertedAt          DateTime?
  // Internal sales judgement of how likely this trainer is to convert to a
  // paying plan: NAH | MAYBE | YEAH | DEFINITELY. Null = not assessed yet.
  // Set by hand from the "Likely" column on /admin/trainers — never derived,
  // and never shown to the trainer.
  conversionLikelihood String?
  // Number of trainer seats the subscription was booked for. Mirrors
  // the Stripe subscription's quantity. 1 by default; bumps via the
  // slider on /billing/setup.
  seatCount            Int                @default(1)
  // Founders Circle: the first FOUNDER_SEATS (10) trainers to subscribe
  // get a Stripe coupon that holds the founder rate for 12 months, then
  // the subscription auto-reverts to standard pricing (the coupon's
  // `duration_in_months` handles the revert — no scheduled job). Stamped
  // by the Stripe webhook on checkout completion, not at checkout
  // creation, so an abandoned checkout never burns a founder seat. The
  // Stripe coupon's own max_redemptions is the hard cap; this flag drives
  // the "N of 10 left" gate and founder copy.
  isFounder            Boolean            @default(false)
  founderClaimedAt     DateTime?
  // Business postal address — captured on /billing/setup, used for
  // Stripe customer billing details, invoice rendering, and tax-region
  // reporting. All optional so existing trainers don't get blocked.
  addressLine1         String?
  addressLine2         String?
  addressCity          String?
  addressRegion        String?
  addressPostcode      String?
  addressCountry       String?
  // The promo code (if any) this trainer redeemed at signup — it set their
  // trialEndsAt. Kept for attribution and so the admin can see redemptions.
  promoCodeId          String?
  // Route manager start/end point ("leave from and return to base"). Captured
  // via Places Autocomplete; lat/lng come from the picked place. Null = the
  // route manager asks them to set a base before optimising.
  baseAddress          String?
  baseLat              Float?
  baseLng              Float?
  basePlaceId          String?

  // ─── Stripe Connect (Flow B: client→trainer payments) ──────────────────────
  // Separate money flow from the trainer's own subscription above. The trainer
  // onboards a Stripe Connect *Express* account; clients pay them via hosted
  // Checkout (destination charge), Stripe takes our application fee and pays
  // the trainer out. None of the stripeCustomerId/stripeSubscriptionId fields
  // above are involved — those are the trainer's subscription TO PupManager.
  connectAccountId          String?   @unique // acct_… (Express). Null = not started.
  connectChargesEnabled     Boolean   @default(false) // mirrors account.charges_enabled
  connectPayoutsEnabled     Boolean   @default(false) // mirrors account.payouts_enabled
  connectDetailsSubmitted   Boolean   @default(false) // account.details_submitted (KYC done)
  connectOnboardedAt        DateTime? // first time charges + payouts both true
  // Trainer's payout / pricing currency for client payments — ISO 4217
  // lower-case (Stripe convention). Seeded from signupCountry on first onboard.
  // SEPARATE from the per-checkout currency used by the subscription flow.
  payoutCurrency            String?
  // ─── Stripe Terminal / Tap to Pay ──────────────────────────────────────────
  // Terminal requires every in-person payment to be attached to a LOCATION, so
  // Stripe knows where the tap physically happened (fraud + dispute rules).
  // Locations live ON THE CONNECTED ACCOUNT, not on the platform, because we
  // take direct charges — so this is created with the Stripe-Account header and
  // is meaningless without connectAccountId. Created lazily the first time a
  // trainer taps, from their business name + postal address.
  //
  // Also the name the CARDHOLDER sees on the tap screen: Stripe shows the
  // location's display_name, so a wrong value here is a wrong merchant name on
  // a stranger's phone. It is re-derived if the trainer renames their business.
  terminalLocationId        String?
  // APPLE's Tap to Pay terms, which every merchant accepts individually with a
  // real Apple ID before their first tap. With direct charges the acceptance is
  // per CONNECTED ACCOUNT, so PupManager accepting as a platform does nothing
  // for the trainer — this is genuinely their paperwork, and these two columns
  // are the only record of it we can hold.
  //
  // Two dates, because they mean different things and only one is proof:
  //   - LinkedAt   we minted them an Apple link. Says they started, nothing more;
  //                Apple's page is Apple's, and there is no webhook back.
  //   - AcceptedAt a device actually connected a Tap to Pay reader on this
  //                account. Stripe's SDK refuses to connect until Apple's terms
  //                are accepted, so a successful connection IS the acceptance,
  //                observed rather than claimed. Never set from a "I did it"
  //                button — a trainer who ticks that and hasn't would be told
  //                they're ready and then fail in front of a customer.
  tapToPayTermsLinkedAt     DateTime?
  tapToPayTermsAcceptedAt   DateTime?
  // Rollout gate for Tap to Pay, same shape and same reasoning as
  // recurringPaymentsEnabled below: a column, not an env var, so switching one
  // customer on is a click rather than a redeploy of every other customer's app.
  // Off for everyone until deliberately turned on — a trainer must never
  // discover this feature by accident, because the first thing it does is take
  // a stranger's card on their phone.
  //
  // NOT the same question as the `pos` add-on. The add-on is what the trainer
  // bought; this is whether the code is ready for them, and only we can answer
  // it — the tap needs a native build carrying Apple's entitlement, and a
  // trainer holding last month's app has the screens but not the radio code.
  tapToPayEnabled           Boolean   @default(false)
  // What this trainer calls the things in their own left menu — a map of nav key
  // to their word for it ({"/packages": "Private lessons"}). A groomer says
  // "Services", a daycare says "Programmes"; the software shouldn't insist.
  // Only deliberate renames are stored (see sanitizeNavLabels), so null/{} means
  // "our words", and a menu item we later rename picks up the new default for
  // everyone who never chose their own.
  navLabels                 Json?
  // Master switch the trainer flips once onboarded — lets them connect but keep
  // prices display-only until they're ready to actually take payments. Defaults
  // ON (and the connect webhook turns it on at onboarding) so a freshly-
  // connected trainer can take payments without flipping another switch.
  acceptPaymentsEnabled     Boolean   @default(true)
  // When true, the card processing fee is added on top of the price at checkout
  // (the client pays it) instead of being absorbed by the trainer, so the
  // trainer nets the full amount. On by default — trainers can opt out.
  passProcessingFeeToClient Boolean   @default(true)
  // Phase-1 rollout gate for RECURRING memberships (client→trainer Stripe
  // Subscriptions on the connected account). The old CONNECT_LIVE_ALLOWLIST env
  // var is gone, so this column IS the allowlist: off for everyone until a
  // trainer is deliberately switched on, visible + flippable per trainer in the
  // admin Businesses screen, no deploy needed.
  //
  // NOTE: passProcessingFeeToClient is NOT honoured on recurring plans. A
  // one-off checkout appends a grossed-up surcharge LINE, which on a
  // subscription would only apply to the first cycle and silently under-recover
  // from cycle two. Supporting it properly needs a second recurring Price
  // (Phase 3). The plan editor says so rather than ignoring the flag quietly.
  recurringPaymentsEnabled  Boolean   @default(false)
  // When the trainer disconnected their Stripe account from PupManager
  // (account.application.deauthorized). We can no longer bill anyone on their
  // behalf, so every live subscription is cancelled and its clients are told.
  // Kept as a timestamp so the reason a business's plans all stopped on one day
  // is answerable months later.
  connectDeauthorizedAt     DateTime?

  // ─── Receivables (payment-method-agnostic invoicing) ────────────────────────
  // When true, a receivable Invoice raised on a priced package/product
  // assignment is emailed to the client immediately (sentAt stamped). When
  // false the Invoice is still created + reconcilable, just left unsent for the
  // trainer to review and send from Finances. Default off — opt-in.
  autoSendInvoices           Boolean @default(false)
  // Default for the per-item "require payment to book" control (packages,
  // classes, products). true preserves the historical behaviour — a priced item
  // + payments switched on means pay-to-book. A trainer can flip this to false
  // to make "book now, pay later" the default, and override per item.
  defaultRequirePayment      Boolean @default(true)
  // Cancellation fee a client is charged when they cancel a booking/enrolment
  // themselves. null or 0 = no fee. Stored in the trainer's payout currency
  // minor units (cents), same as every other price on this model.
  cancellationFeeCents       Int?
  // The fee only applies when the client cancels within this many hours of the
  // session start (a "late cancellation" window). null = the fee applies to ANY
  // cancellation whenever cancellationFeeCents is set (no grace window). e.g. 24
  // means only cancellations inside 24h of the start are charged.
  cancellationFeeWindowHours Int?

  // ─── Bulk-email sending domain (Resend) ─────────────────────────────────────
  // To send bulk emails to their clients the trainer must verify a *sending
  // subdomain* of their own domain (e.g. mail.theirbusiness.com) — sending off a
  // subdomain keeps the broadcast reputation off the root domain and is Resend's
  // recommended setup. `sendingDomain` is what they entered (mail.theirbiz.com);
  // `resendDomainId` is the Resend domain record id we poll for verification;
  // `sendingFromEmail` is the resolved verified From (hello@mail.theirbiz.com);
  // `domainVerifiedAt` is stamped once Resend reports the domain verified — the
  // bulk-send route hard-blocks until it is non-null.
  sendingDomain         String?
  resendDomainId        String?   @unique
  sendingFromEmail      String?
  domainVerifiedAt      DateTime?
  // Lets the trainer try bulk email immediately on PupManager's shared verified
  // sender ("<Name> via PupManager") WITHOUT verifying their own domain — a
  // test/trial escape hatch. The trial daily cap still applies. Verifying their
  // own domain is the production path; this just unblocks a first send.
  useTrialSendingDomain Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionPlan   SubscriptionPlan?          @relation(fields: [subscriptionPlanId], references: [id])
  promoCode          PromoCode?                 @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  clients            ClientProfile[]
  sharedClients      ClientShare[]              @relation("SharedByTrainer")
  receivedClients    ClientShare[]              @relation("SharedWithTrainer")
  trainingSessions   TrainingSession[]
  trainingTemplates  TrainingTemplate[]
  customFields       CustomField[]
  libraryTypes       LibraryType[]
  embedForms         EmbedForm[]
  forms              Form[]
  enquiries          Enquiry[]
  emailTemplates     EmailTemplate[]
  broadcasts         EmailBroadcast[]
  messageGroups      MessageGroup[]
  timeRates          TimeRate[]
  timesheets         Timesheet[]
  sentNotifications  ClientNotification[]
  availabilitySlots  AvailabilitySlot[]
  blackoutPeriods    BlackoutPeriod[]
  bookingPages       BookingPage[]
  leadMagnets        LeadMagnet[]
  subscribers        Subscriber[]
  packages           Package[]
  sessionForms       SessionForm[]
  products           Product[]
  achievements       Achievement[]
  classRuns          ClassRun[]
  commsFlowTemplates CommsFlowTemplate[]
  discounts          Discount[]
  memberships        Membership[]
  waitlistEntries    WaitlistEntry[]
  bookingRequests    BookingRequest[]
  activityWeeks      TrainerActivityWeek[]
  badgeAwards        TrainerBadgeAward[]
  onboardingProgress TrainerOnboardingProgress?
  members            TrainerMembership[]        @relation("CompanyMembers")
  addons             TrainerAddon[]
  payments           Payment[]
  invoices           Invoice[]
  brainDumps         TrainerBrainDump[]
  todos              TrainerTodo[]
  xeroConnection     XeroConnection?
  linkPage           LinkPage?
  locations          Location[]
  productCategories  ProductCategory[]
  stockMovements     StockMovement[]
  productVariants    ProductVariant[]
  tags               Tag[]

  @@map("trainer_profiles")
}

// ─── Instagram "link in bio" add-on ───────────────────────────────────────────
// A customizable Linktree-style PUBLIC page for a trainer, served at /l/<slug>.
// One row per trainer (created on first visit to the editor). The buttons the
// public page renders come from the trainer's branding + these config flags +
// the ordered LinkPageButton rows.
model LinkPage {
  id            String           @id @default(cuid())
  trainerId     String           @unique
  trainer       TrainerProfile   @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  headline      String?
  bio           String?          @db.Text
  // DEPRECATED — the fixed built-in toggles + itemOrder + buttonStyles below are
  // no longer read or written. Every button (incl. booking/website/contact) is
  // now a per-row LinkPageButton with its own type/order/style. Columns are kept
  // to match the DB (no destructive migration); do NOT reintroduce reads/writes.
  showBooking   Boolean          @default(true)
  showWebsite   Boolean          @default(true)
  showContact   Boolean          @default(true)
  instagram     String? // handle or full URL
  facebook      String?
  tiktok        String?
  socialsLabel  String? // heading above the social icon row, e.g. "Connect with us"
  backgroundUrl String? // full-cover background image (Vercel Blob URL)
  font          String? // font id from LINK_PAGE_FONTS; null = default
  // Global button order across BOTH the built-ins and the custom links. Keys:
  // 'book' | 'website' | 'contact' | 'custom:<LinkPageButton.id>'. Empty = the
  // legacy default order (book → customs → website → contact); the show* flags
  // still gate on/off, LinkPageButton.order stays but is secondary.
  itemOrder     String[]         @default([])
  // Per-button style overrides, keyed by the SAME button keys the builder uses
  // ('book' | 'website' | 'contact' | 'custom:<LinkPageButton.id>'). Each value is
  // { imageUrl?, bgColor?, textColor?, font? }; any absent sub-field falls back to
  // the page-level styling. 'contact' styles BOTH the email and call buttons.
  buttonStyles  Json?
  links         LinkPageButton[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("link_pages")
}

// A single "smart link" button on a LinkPage. Ordered by `order` (ascending).
// Every button — booking, lead magnet, get-in-touch form, client sign-in,
// website, email, call, or a raw custom URL — is one row here. `type` decides
// how the href is resolved at render time (see src/lib/link-page.ts); `targetId`
// carries the type-specific reference (booking-page slug, lead-magnet slug, or
// embed-form id). Only CUSTOM stores a raw `url`. Per-button styling lives on the
// row (imageUrl / bgColor / textColor), replacing the old LinkPage.buttonStyles.
model LinkPageButton {
  id         String   @id @default(cuid())
  linkPageId String
  linkPage   LinkPage @relation(fields: [linkPageId], references: [id], onDelete: Cascade)
  // One of: CUSTOM | BOOKING | LEADMAGNET | FORM | SIGNIN | WEBSITE | EMAIL | CALL.
  type       String   @default("CUSTOM")
  label      String
  // Only CUSTOM stores a raw http(s) url; all other types resolve their href
  // from the trainer's data, so this is null for them.
  url        String?
  // Type-specific target: BOOKING → booking-page slug (null = booking home),
  // LEADMAGNET → magnet slug, FORM → embed-form id. Null for the rest.
  targetId   String?
  // Per-button style overrides (each falls back to the page-level styling).
  imageUrl   String?
  bgColor    String?
  textColor  String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([linkPageId])
  @@map("link_page_buttons")
}

// ─── Xero accounting integration ──────────────────────────────────────────────
// Per-trainer connection to their own Xero organisation (OAuth2). One row per
// trainer who has connected. When the trainer disconnects we delete the row,
// so presence of a row == "connected". Each trainer's invoices/payments sync to
// their OWN Xero org — this is the multi-tenant, trainer-keeps-their-books model.
model XeroConnection {
  id        String         @id @default(cuid())
  trainerId String         @unique
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  // OAuth tokens. The refresh token ROTATES on every refresh — always persist
  // the newest one returned by the token endpoint or the connection dies. The
  // access token is cached with its expiry so we only refresh when stale.
  refreshToken         String    @db.Text
  accessToken          String?   @db.Text
  accessTokenExpiresAt DateTime?

  // The connected organisation. A single Xero login can expose multiple orgs;
  // we capture the one chosen at connect time (first ORGANISATION tenant).
  tenantId   String
  tenantName String?

  // Account + tax mapping (populated in Phase 1 from the org's chart of
  // accounts). bankAccountCode = the trainer's REAL bank account (where Stripe's
  // payout lands, reconciled from the bank feed); salesAccountCode = fallback
  // revenue account for line items with no per-product mapping; taxType =
  // default Xero tax type code (e.g. "NONE").
  bankAccountCode  String?
  bankAccountName  String?
  salesAccountCode String?
  taxType          String?
  // Curated shortlist of income accounts the trainer uses — [{ code, name }].
  // Product/package/class create forms offer these when assigning an account.
  accountShortlist Json?

  // ── Stripe clearing model (so the bank feed actually reconciles) ────────────
  // Stripe never pays the gross into the bank: it deducts its processing fee AND
  // our application fee first. So a card payment is NOT posted to bankAccountCode
  // — it's posted to a Stripe CLEARING account (a Xero account of Type=BANK the
  // trainer creates, e.g. "Stripe Clearing"), and the two fees are written out of
  // that clearing account as SPEND bank transactions coded to feeAccountCode.
  // Stripe's payout then arrives in the real bank feed and reconciles as a
  // transfer clearing → bank, to the cent.
  //
  //   clearingAccountCode  BANK-type account the gross client payment lands in
  //   feeAccountCode       EXPENSE account the Stripe + PupManager fees are coded to
  //   surchargeAccountCode REVENUE account for a client-paid card surcharge
  //                        (income the trainer received). Falls back to salesAccountCode.
  clearingAccountCode  String?
  clearingAccountName  String?
  feeAccountCode       String?
  surchargeAccountCode String?

  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("xero_connections")
}

// ─── Google Calendar integration ──────────────────────────────────────────────
// Per-STAFF-MEMBER, ONE-WAY sync (PupManager → that person's own Google
// Calendar). Keyed by the individual's TrainerMembership, NOT the company — so
// each staff member connects their own account and their own sessions land in
// their own calendar. companyId is denormalised for scoping/gating queries.
// One row per connected member; deleting the row == disconnected. Google refresh
// tokens normally do NOT rotate, but the access token is short-lived and cached
// with its expiry so we only refresh when stale — and we persist a rotated
// refresh token on the rare occasion one is returned, or the connection dies.
model GoogleCalendarConnection {
  id           String            @id @default(cuid())
  membershipId String            @unique
  membership   TrainerMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  // The business this member belongs to (== TrainerMembership.companyId). Kept
  // here so the add-on gate + cron scoping don't need a join.
  companyId    String

  refreshToken         String    @db.Text
  accessToken          String?   @db.Text
  accessTokenExpiresAt DateTime?

  // Which of the member's calendars events are written to. "primary" is their
  // default calendar; kept configurable so a member could point sync at a
  // dedicated "PupManager" calendar later without a schema change.
  calendarId String @default("primary")

  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@map("google_calendar_connections")
}

// Busy times imported FROM a connected member's Google Calendar (the two-way
// half: Google → PupManager). Refreshed as a window (now → ~60 days) on connect
// and by the busy-refresh cron — delete + reinsert per member each time. Used
// only to WARN (never block) when a new/edited session overlaps something the
// member already has in their personal calendar.
model GoogleBusyBlock {
  id           String            @id @default(cuid())
  membershipId String
  membership   TrainerMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  companyId    String
  startsAt     DateTime
  endsAt       DateTime
  // The event's title, for the schedule hover popup. Null for busy blocks with
  // no summary (or imported via FreeBusy, which returns no details).
  title        String?
  // Google's event id for the busy block, when returned (informational).
  sourceId     String?
  createdAt    DateTime          @default(now())

  @@index([membershipId, startsAt])
  @@map("google_busy_blocks")
}

// ─── Promo codes ──────────────────────────────────────────────────────────────
// A shared code a trainer enters at signup. When valid it SETS their total
// trial length (trialEndsAt = signup + trialDays) instead of the default 10.
// One code is reusable by many trainers; optional expiry + redemption cap.
model PromoCode {
  id             String    @id @default(cuid())
  // Stored upper-cased; lookups upper-case the entered value so it's
  // case-insensitive without a functional index.
  code           String    @unique
  // Total trial length (in days) granted when this code is used.
  trialDays      Int
  // Null = never expires. A code past this instant no longer redeems.
  expiresAt      DateTime?
  // Null = unlimited. Once redeemedCount reaches this, the code stops working.
  maxRedemptions Int?
  redeemedCount  Int       @default(0)
  // Lets an admin pause a code without deleting it (and losing attribution).
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  redemptions TrainerProfile[]

  @@map("promo_codes")
}

// ─── Trainer Memberships (multi-trainer businesses) ───────────────────────────
// One row per (business, person). The business is a TrainerProfile (the tenant
// every other model already scopes to via trainerId); a member is a User who
// logs in with their own account. The founding owner has an OWNER row here in
// addition to owning the TrainerProfile, so sessions/clients can be assigned to
// them uniformly. Invited trainers have ONLY a membership (no trainerProfile),
// and resolve their company via this row in the auth callbacks.
model TrainerMembership {
  id          String      @id @default(cuid())
  companyId   String // → TrainerProfile.id (the business / tenant)
  userId      String // → User.id (the member's login)
  role        CompanyRole @default(STAFF)
  // Optional display title shown on the schedule / team list ("Senior trainer").
  title       String?
  // Granular permission overrides layered on top of the role preset. Flat map
  // of permissionKey → boolean, e.g. {"packages.manage": true, "billing.view": false}.
  // A missing key falls back to the role's default for that permission, so an
  // empty object means "use the role preset verbatim". OWNER ignores this map
  // (always full access). See src/lib/permissions.ts for the catalogue + defaults.
  permissions Json        @default("{}")
  // Invite lifecycle. invitedAt stamps creation; acceptedAt is null while the
  // invite is outstanding and set once the member first signs in / accepts.
  invitedAt   DateTime    @default(now())
  acceptedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company TrainerProfile @relation("CompanyMembers", fields: [companyId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Work assigned to this member. SetNull (not Cascade) so removing a member
  // leaves their sessions/clients intact but unassigned, for reassignment.
  assignedSessions TrainingSession[] @relation("AssignedTrainer")
  assignedClients  ClientProfile[]   @relation("AssignedTrainer")

  // Time this member has logged against sessions (billable hours).
  timeEntries SessionTimeEntry[] @relation("TimeEntryMember")

  // Group classes (ClassRun) this member is assigned to run.
  assignedClassRuns ClassRunTrainer[]

  // Dashboard to-do items assigned to this member.
  assignedTodos TrainerTodo[] @relation("TodoAssignee")

  // This member's OWN Google Calendar connection (per-staff, one-way sync) and
  // the busy-times imported from it (for soft double-booking warnings).
  googleCalendarConnection GoogleCalendarConnection?
  googleBusyBlocks         GoogleBusyBlock[]

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
  @@map("trainer_memberships")
}

// Per-member time logged against a single session — billable hours. Several
// members can each log time on the same session ("Sam logged 1.5h, Sally 0.5h").
// minutes is the duration; rateCents is the hourly rate used to bill it (null =
// not billable / rate not set). loggedById records who entered it (audit only).
model SessionTimeEntry {
  id           String  @id @default(cuid())
  sessionId    String
  membershipId String // whose time this is → TrainerMembership.id
  minutes      Int // duration in minutes
  rateCents    Int? // hourly rate in cents; null = non-billable
  note         String? @db.Text
  loggedById   String? // membership that recorded the entry (audit, no FK)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session    TrainingSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  membership TrainerMembership @relation("TimeEntryMember", fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([membershipId])
  @@map("session_time_entries")
}

// ─── Timesheets ──────────────────────────────────────────────────────────────

// A named, reusable hourly rate the business defines (e.g. "Training" $80/hr,
// "Travel" $40/hr). Time entries pick one; the entry snapshots the rate so
// editing/archiving a rate later doesn't rewrite finalised timesheets.
model TimeRate {
  id         String    @id @default(cuid())
  companyId  String // → TrainerProfile.id
  name       String
  rateCents  Int // hourly rate in cents (company currency)
  archivedAt DateTime? // hidden from new pickers but kept for history
  sortOrder  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company TrainerProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entries TimeEntry[]

  @@index([companyId])
  @@map("time_rates")
}

// A weekly timesheet owned by one staff member. DRAFT while editable; FINALISED
// locks the entries and stamps finalisedAt. recipientEmail/sentAt track the
// emailed PDF (defaults to the company owner on send).
model Timesheet {
  id             String    @id @default(cuid())
  companyId      String // → TrainerProfile.id (tenant)
  userId         String // → User.id (whose timesheet — owner or staff member)
  weekStart      DateTime  @db.Date // Monday of the week (date only)
  title          String?
  status         String    @default("DRAFT") // "DRAFT" | "FINALISED"
  notes          String?   @db.Text
  recipientEmail String?
  finalisedAt    DateTime?
  sentAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company TrainerProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entries TimeEntry[]

  @@index([companyId, userId, weekStart])
  @@map("timesheets")
}

// One line on a timesheet: a dated task with a duration and (optional) rate.
// minutes is the duration source of truth; rateCents/rateName snapshot the
// chosen TimeRate; amountCents = round(minutes/60 * rateCents) (or a manual
// amount). Optionally tied to a client.
model TimeEntry {
  id          String   @id @default(cuid())
  timesheetId String
  date        DateTime @db.Date
  task        String
  minutes     Int      @default(0)
  rateId      String? // → TimeRate.id (null = manual/no rate)
  rateName    String? // snapshot of the rate name at entry time
  rateCents   Int? // snapshot of the hourly rate in cents
  amountCents Int      @default(0) // computed (or manually overridden) line total
  clientId    String? // → ClientProfile.id (optional association)
  category    String?
  notes       String?  @db.Text
  sortOrder   Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timesheet Timesheet      @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  rate      TimeRate?      @relation(fields: [rateId], references: [id], onDelete: SetNull)
  client    ClientProfile? @relation("ClientTimeEntries", fields: [clientId], references: [id], onDelete: SetNull)

  @@index([timesheetId])
  @@index([clientId])
  @@map("time_entries")
}

// ─── Client & Dog ────────────────────────────────────────────────────────────

model ClientProfile {
  id                   String  @id @default(cuid())
  // A user can hold several client relationships — one per trainer (tenant).
  // Uniqueness is therefore on the (userId, trainerId) pair, not userId alone.
  userId               String
  trainerId            String // owning business (TrainerProfile = tenant)
  // The member trainer this client is assigned to within the business. Null =
  // unassigned (visible to owner/managers; not to any single staff member).
  // Distinct from trainerId, which is the tenant the client's data lives under.
  assignedMembershipId String?
  dogId                String? // set after onboarding
  status               String  @default("ACTIVE") // "ACTIVE" | "INACTIVE"
  // Auto-generated "Sample" client seeded by the first-run personalization
  // wizard so a brand-new trainer can preview the client app. Removed on
  // demand or when the trainer adds their first real client.
  isSample             Boolean @default(false)
  // Contact phone for the client (collected on intake). Lives on the
  // profile, not on User, mirroring TrainerProfile.phone — phone is a
  // per-trainer-relationship attribute (a client may share a phone
  // with another household member who has their own User row).
  phone                String?
  // Visit location for the route manager. Captured via Places Autocomplete, so
  // lat/lng come from the picked place (no separate geocoding call). placeId is
  // kept for re-lookup/dedup. All null until an address is set.
  addressLine          String?
  addressLat           Float?
  addressLng           Float?
  addressPlaceId       String?

  // Set when an invitation email is actually sent to the client (via the
  // invite form with notifications on, or a re-invite). Null = the client
  // record was created/added but never invited. Powers the "Invite your
  // first client" onboarding step, kept distinct from "Create a client".
  invitedAt DateTime?

  // The intake Form this client was assigned (chosen at invite time), when they
  // completed it, and their answers. While intakeFormId is set and
  // intakeCompletedAt is null the client is gated behind that form before
  // reaching their home screen — it takes priority over the legacy
  // required-custom-fields gate. Existing clients have a null intakeFormId, so
  // nobody is gated retroactively.
  //
  // intakeAnswers is keyed by question id → string | string[]. CUSTOM_FIELD
  // answers are ALSO mirrored to CustomFieldValue on submit, so the rest of the
  // app (client profile, reports) reads them the usual way.
  intakeFormId      String?
  intakeCompletedAt DateTime?
  intakeAnswers     Json?

  // Private, trainer-facing free-text notes about this client (not shown to the
  // client; distinct from per-session notes). Scoped to the (userId,trainerId)
  // relationship like everything else on this model.
  notes String? @db.Text

  // Bulk/marketing email opt-out, scoped to THIS trainer relationship (matching
  // the composite (userId, trainerId) model — a person can be opted out for one
  // trainer but not another). Set either by the client clicking Unsubscribe in a
  // broadcast footer, or automatically when Resend reports a hard bounce /
  // spam complaint (suppression). Transactional 1:1 messages ignore this; only
  // bulk broadcasts respect it. `marketingOptOutReason` records why.
  marketingEmailOptOut  Boolean   @default(false)
  marketingOptOutAt     DateTime?
  marketingOptOutReason String? // "UNSUBSCRIBED" | "BOUNCED" | "COMPLAINED"

  // The matching Xero Contact id, once this client has been synced to the
  // trainer's Xero org (Phase 2). Null = not yet synced. Scoped naturally to the
  // (userId, trainerId) relationship, so the same person maps to a different
  // contact in each trainer's org.
  xeroContactId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainer         TrainerProfile     @relation(fields: [trainerId], references: [id])
  assignedTrainer TrainerMembership? @relation("AssignedTrainer", fields: [assignedMembershipId], references: [id], onDelete: SetNull)
  dog             Dog?               @relation("PrimaryDog", fields: [dogId], references: [id])
  intakeForm      Form?              @relation("ClientIntakeForm", fields: [intakeFormId], references: [id], onDelete: SetNull)

  diaryEntries        TrainingTask[]
  trainingSessions    TrainingSession[]
  classEnrollments    ClassEnrollment[]
  waitlistEntries     WaitlistEntry[]
  bookingRequests     BookingRequest[]
  shares              ClientShare[]
  messages            Message[]                 @relation("ClientMessages")
  groupParticipations MessageGroupParticipant[]
  customFieldValues   CustomFieldValue[]
  dogs                Dog[]                     @relation("AdditionalDogs")
  timeEntries         TimeEntry[]               @relation("ClientTimeEntries")
  notifications       ClientNotification[]
  clientPackages      ClientPackage[]
  productRequests     ProductRequest[]
  membershipRequests  MembershipRequest[]
  membershipConsents  MembershipConsent[]

  // The Stripe Customer for this client ON THIS TRAINER'S connected account, for
  // recurring memberships. A Customer belongs to exactly one account, so a
  // client who trains with two businesses genuinely has two unrelated Customers
  // and enters their card twice — that is a Stripe constraint, not a choice.
  // ClientProfile is already the (userId, trainerId) pair, so it is the correct
  // home for the id. Split live/test: a sandbox cus_… means nothing in live mode.
  stripeCustomerId     String?
  stripeCustomerIdTest String?
  buddySessions        SessionBuddy[]
  achievements         ClientAchievement[]
  payments             Payment[]
  invoices             Invoice[]
  enquiry              Enquiry?
  stockMovements       StockMovement[]

  @@unique([userId, trainerId])
  @@index([userId])
  @@index([trainerId])
  @@index([assignedMembershipId])
  @@map("client_profiles")
}

model Dog {
  id              String    @id @default(cuid())
  name            String
  breed           String?
  weight          Float? // kg
  dob             DateTime?
  photoUrl        String?
  notes           String?   @db.Text
  clientProfileId String? // owner (for additional dogs in a household)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  // Set when the dog has died. A real column rather than a custom field because
  // it must change behaviour: deceased dogs are excluded from class invites,
  // rosters/enrolment pickers, attendance lists and reminders, while staying
  // visible on the owner's profile so their history is preserved.
  deceasedAt DateTime?

  primaryFor       ClientProfile[]   @relation("PrimaryDog")
  owner            ClientProfile?    @relation("AdditionalDogs", fields: [clientProfileId], references: [id])
  sessions         TrainingSession[]
  tasks            TrainingTask[]
  buddySessions    SessionBuddy[]
  classEnrollments ClassEnrollment[]
  media            DogMedia[]

  @@index([clientProfileId])
  @@map("dogs")
}

// Trainer-curated photo/video gallery for a dog. Surfaced as the hero on the
// client home + dog profile. Mirrors session_attachments (public Blob URLs,
// unguessable pathnames; the API endpoints enforce trainer ownership).
model DogMedia {
  id           String         @id @default(cuid())
  dogId        String
  trainerId    String // denormalised for fast permission checks
  kind         AttachmentKind
  url          String
  thumbnailUrl String? // client-generated still for video previews
  caption      String?        @db.Text
  order        Int            @default(0)

  createdAt DateTime @default(now())

  dog Dog @relation(fields: [dogId], references: [id], onDelete: Cascade)

  @@index([dogId])
  @@index([trainerId])
  @@map("dog_media")
}

// ─── Client Sharing ───────────────────────────────────────────────────────────

model ClientShare {
  id           String    @id @default(cuid())
  clientId     String
  sharedById   String
  sharedWithId String
  shareType    ShareType
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())

  client     ClientProfile  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sharedBy   TrainerProfile @relation("SharedByTrainer", fields: [sharedById], references: [id])
  sharedWith TrainerProfile @relation("SharedWithTrainer", fields: [sharedWithId], references: [id])

  @@index([clientId])
  @@index([sharedWithId])
  @@map("client_shares")
}

// ─── Training Diary & Tasks ───────────────────────────────────────────────────

model TrainingTask {
  id            String         @id @default(cuid())
  clientId      String
  dogId         String? // optional: which dog this task is for
  sessionId     String? // optional: linked training session
  date          DateTime       @db.Date
  title         String
  description   String?        @db.Text
  repetitions   Int?
  videoUrl      String? // trainer-provided instructional link — FIRST of `videos`
  /// The instructional videos, copied from the library item at hand-out time:
  /// `[{ url, title? }]`. A snapshot like the title and description are, so
  /// re-cutting the library item never changes homework already given out.
  videos        Json           @default("[]")
  trainerNote   String?        @db.Text // per-task comment from the trainer
  /// Everything the trainer attached, in their order — the same shape as
  /// LibraryTask.media, copied at hand-out time. Its arrival is what finally
  /// gets a HANDOUT to a client: the assign path copied the picture and the
  /// clips but had nowhere to put a PDF, so a trainer who attached one handed
  /// out homework that had silently lost it.
  ///
  /// `videos`/`videoUrl`/`imageUrls` are derived from it by
  /// lib/library-media.ts (`homeworkMediaColumns`) so the older readers — the
  /// client's own log panel, the session screen — keep working unchanged.
  media         Json           @default("[]")
  imageUrls     Json           @default("[]") // string[] of public image URLs — the image rows of `media`
  /// Whether the client is asked to log sessions against this. Copied from the
  /// library item at hand-out time (LibraryTask.wantsLog) — homework is a snapshot,
  /// so changing the item later never changes work already given out.
  wantsLog      Boolean        @default(true)
  /// Preparation for the session, or practice after it. Copied from the
  /// offering's default row at hand-out time (PackageDefaultTask.timing), and a
  /// snapshot like everything else here.
  ///
  /// This is what decides whether the CLIENT can see the task yet: an
  /// AFTER_SESSION task stays hidden until its session has run, a
  /// BEFORE_SESSION one shows the moment it is handed out. Homework with no
  /// session behind it has nothing to wait for and is always visible. The one
  /// predicate lives in lib/homework-visibility.ts — never re-derive it.
  timing        HomeworkTiming @default(AFTER_SESSION)
  order         Int            @default(0) // display order within a session
  // Which library item this homework was created from, when it came from the
  // Library. The row stays a SNAPSHOT (title/description are copied, so editing
  // the library item never rewrites work already handed out) — this is purely a
  // provenance link so the library item can show who currently has it.
  libraryTaskId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client      ClientProfile    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dog         Dog?             @relation(fields: [dogId], references: [id])
  session     TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  libraryTask LibraryTask?     @relation(fields: [libraryTaskId], references: [id], onDelete: SetNull)
  completion  TaskCompletion?
  logs        TrainingLog[]

  @@index([clientId])
  @@index([date])
  @@index([sessionId])
  @@index([libraryTaskId])
  // The client-visibility gate reads both on every screen that lists homework.
  @@index([timing, sessionId])
  @@map("training_tasks")
}

model TaskCompletion {
  id          String   @id @default(cuid())
  taskId      String   @unique
  completedAt DateTime @default(now())
  note        String?  @db.Text
  videoUrl    String? // client-submitted link
  videoS3Key  String? // native video upload (S3)

  task TrainingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_completions")
}

// A client-logged practice record against a homework task. Unlike TaskCompletion
// (one row = "done this week"), there are MANY of these per task: the client logs
// each time they practise, building a history the trainer can see progress in.
// The first log flips the task's completion on; further logs just add to the
// record. rating is an optional 1–3 self-assessment (1 tough · 2 okay · 3 great).
model TrainingLog {
  id        String   @id @default(cuid())
  taskId    String
  loggedAt  DateTime @default(now())
  note      String?  @db.Text
  repsDone  Int?
  rating    Int? // 1..3, optional "how did it go"
  videoUrl  String? // optional client-submitted link
  imageUrls Json     @default("[]") // string[] of public image URLs the client attached

  // One editable comment the trainer can leave back on this log (feedback loop).
  trainerComment   String?   @db.Text
  trainerCommentAt DateTime?

  createdAt DateTime @default(now())

  task TrainingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("training_logs")
}

// ─── Scheduling ──────────────────────────────────────────────────────────────

model TrainingSession {
  id                   String        @id @default(cuid())
  trainerId            String // owning business (tenant)
  // The member trainer running this session. Null = unassigned (sole-trainer
  // businesses leave this null; the owner is implied). Drives the calendar
  // colour/filter and staff scoping in multi-trainer businesses.
  assignedMembershipId String?
  clientId             String? // direct client link (optional, in addition to dogId)
  dogId                String?
  clientPackageId      String? // membership in an assigned package
  // Group classes: a shared session belongs to a ClassRun (cohort) rather
  // than a single client. For group sessions clientId/dogId stay null —
  // attendance is tracked per-enrollee via SessionAttendance. sessionIndex
  // is the 1-based position within the run ("session 3 of 6"), also the
  // join point used for drop-in pricing.
  classRunId           String?
  sessionIndex         Int?
  // SERIES: which curriculum step this session actually covers.
  //
  // NOT the same as its position in the series. The trainer may SKIP a step for
  // a client whose dog already has it, so a client's 2nd session can be step 3 —
  // which is why this is STORED rather than counted off the calendar. Null =
  // nobody has said yet, and the natural order stands in (see lib/series.ts).
  // Only the trainer changes it; a client never skips a step.
  sessionPlanId        String?
  // Links the sessions of a recurring "buddies walk" (a group dog walk created
  // from the schedule). Lets a dog added later be applied to just this walk,
  // this + following walks, or the whole series. Null for non-walk sessions.
  walkSeriesId         String?
  // Per-session session-form override for class sessions. Null = inherit the
  // class's default form (the group package's defaultSessionFormId). Lets a run
  // use one form for most sessions and a different one on, say, the last.
  sessionFormId        String?
  // The booking page this session was created from (instant book, accepted
  // prospect, or confirmed request). Drives BEFORE/AFTER_SESSION automations.
  // SetNull so deleting the page leaves the session intact.
  bookingPageId        String?
  // The drop-in schedule slot this session was generated from. Carries the
  // session's own price, capacity, payment rule and Xero account, so a drop-in
  // class can charge (and cap) each session differently. Null for every other
  // kind of session. SetNull, not Cascade: re-editing the class's schedule must
  // never delete sessions already in the diary.
  packageSessionSlotId String?
  title                String
  description          String?       @db.Text
  scheduledAt          DateTime
  durationMins         Int           @default(60)
  // Turnaround gap this session was BOOKED with (travel / clean-up / reset),
  // snapshotted from the ClassRun override → its Package → 0 at creation time.
  // Held on the session (not read through the package) because there is no
  // endsAt: every clash/availability check already has the session row, and a
  // later edit to the package must not silently move bookings that are already
  // in the diary. Occupied window = [scheduledAt, +durationMins +bufferMins).
  bufferMins           Int           @default(0)
  sessionType          SessionType   @default(IN_PERSON)
  status               SessionStatus @default(UPCOMING)
  // Whether the trainer has invoiced this session (Xero/QBO/manual). Tracked
  // separately from `status` because invoicing can happen before OR after the
  // session is marked complete — the lifecycles are orthogonal. Null = not
  // invoiced; set = invoiced at this timestamp.
  invoicedAt           DateTime?
  location             String?
  virtualLink          String?

  googleCalendarEventId String?

  // Set when the "starting in ~20 min" push reminder has been delivered to the
  // trainer, so the cron loop never sends two pushes for the same session.
  reminderPushSentAt        DateTime?
  // Same idea for the "ends in ~5 min — write session notes" reminder.
  notesReminderPushSentAt   DateTime?
  // Set when this session was rescheduled but the client hasn't been told yet.
  // The trainer batch-sends pending reschedules from a banner, so dragging
  // sessions around doesn't fire a notification on every move.
  rescheduleNotifyPendingAt DateTime?

  // ─── One occurrence of a run, changed on its own ───────────────────────────
  //
  // A weekly casual class runs for months. One week falls on a public holiday;
  // another has to start an hour later. Before these three columns the only
  // tool was DELETE — which took the register and every drop-in booking with
  // it (both cascade), and which the nightly slot top-up would then quietly
  // undo, because a deleted date leaves nothing behind to say it was deliberate.
  //
  // See lib/run-occurrences.ts. Nothing here may be re-derived elsewhere.

  /// When the trainer called this ONE occurrence off. The row deliberately
  /// STAYS: it keeps the register and the drop-in bookings that cascade off it,
  /// it tells the client their class is cancelled rather than making it vanish,
  /// and — the reason it is a column and not a delete — it is the tombstone
  /// that stops the nightly top-up putting the date back.
  ///
  /// Everything that counts, charges, reminds or offers a session filters on
  /// this being null.
  cancelledAt          DateTime?
  /// What the trainer told the client, e.g. "Labour Day". Free text, optional.
  cancelReason         String?
  /// When the trainer moved THIS occurrence on its own — a new time, a longer
  /// slot, a different venue. Marks the row as hand-set, so a class-wide
  /// rebuild or a venue propagation can't quietly put it back.
  scheduleOverriddenAt DateTime?
  /// Where the generator had originally put it. Only set alongside
  /// scheduleOverriddenAt, and only ever written once — this is what lets the
  /// slot planner recognise "I already made this one, they moved it" instead of
  /// creating it again at the old time.
  originalScheduledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainer                  TrainerProfile          @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  assignedTrainer          TrainerMembership?      @relation("AssignedTrainer", fields: [assignedMembershipId], references: [id], onDelete: SetNull)
  client                   ClientProfile?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  dog                      Dog?                    @relation(fields: [dogId], references: [id])
  clientPackage            ClientPackage?          @relation(fields: [clientPackageId], references: [id], onDelete: SetNull)
  sessionPlan              PackageSessionPlan?     @relation(fields: [sessionPlanId], references: [id], onDelete: SetNull)
  tasks                    TrainingTask[]
  formResponses            SessionFormResponse[]
  fulfilledProductRequests ProductRequest[]
  buddies                  SessionBuddy[]
  attachments              SessionAttachment[]
  classRun                 ClassRun?               @relation(fields: [classRunId], references: [id], onDelete: Cascade)
  attendance               SessionAttendance[]
  dropInEnrollments        ClassEnrollment[]       @relation("DropInSession")
  bookingPage              BookingPage?            @relation(fields: [bookingPageId], references: [id], onDelete: SetNull)
  packageSessionSlot       PackageSessionSlot?     @relation(fields: [packageSessionSlotId], references: [id], onDelete: SetNull)
  automationSends          BookingAutomationSend[]
  commsFlowSends           CommsFlowSend[]
  paymentItem              PaymentItem?
  timeEntries              SessionTimeEntry[]

  @@index([trainerId])
  @@index([assignedMembershipId])
  @@index([clientId])
  @@index([scheduledAt])
  @@index([bookingPageId])
  // Composite for the hot path: "this trainer's sessions in a date range"
  // (schedule grid, dashboard, route day) — one index scan instead of
  // filtering a trainerId or scheduledAt index.
  @@index([trainerId, scheduledAt])
  @@index([clientPackageId])
  @@index([classRunId])
  // Every count, price and roster on a run now asks for its LIVE sessions.
  @@index([classRunId, cancelledAt])
  @@index([sessionPlanId])
  @@index([walkSeriesId])
  @@index([packageSessionSlotId])
  @@map("training_sessions")
}

// Trainer-uploaded media attached to a session — photos and short clips
// captured during/after a session and surfaced in the session detail
// page. Lives in Vercel Blob (no transcoding) for v1; if/when we move
// video to a streaming service the schema can grow a `provider` enum
// without changing call sites.
model SessionAttachment {
  id           String         @id @default(cuid())
  sessionId    String
  trainerId    String // denormalised for fast permission checks
  kind         AttachmentKind
  // Public Blob URL. We don't gate access via signing for v1 — the
  // pathname includes the session + attachment id so URLs are
  // unguessable, and the API endpoints that hand them out enforce
  // trainer ownership.
  url          String
  // Optional client-generated thumbnail still for video previews.
  thumbnailUrl String?
  // Free-form caption / note the trainer can add when uploading.
  caption      String?        @db.Text
  // Stored for display ("12 sec") and for soft-quota calculations later.
  sizeBytes    Int
  durationMs   Int? // videos only

  createdAt DateTime @default(now())

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([trainerId])
  @@map("session_attachments")
}

// "Buddy session" — additional client/dog pairs attending a TrainingSession
// alongside the primary client/dog. Trainer-only visibility (the buddy client's
// portal does not surface these). Same client may appear twice with two
// different dogs, so the unique key includes dogId.
model SessionBuddy {
  id        String   @id @default(cuid())
  sessionId String
  clientId  String
  dogId     String?
  createdAt DateTime @default(now())

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  client  ClientProfile   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dog     Dog?            @relation(fields: [dogId], references: [id], onDelete: SetNull)

  @@unique([sessionId, clientId, dogId])
  @@index([sessionId])
  @@index([clientId])
  @@map("session_buddies")
}

// ─── Tags (one list, every kind of offering) ─────────────────────────────────

// A trainer's own cross-cutting label — "Puppy", "Reactivity", "Agility".
//
// NOT another ProductCategory. A category is a shelf in the shop and reaches
// products only; a tag reaches ACROSS the kinds of thing a trainer sells, so
// the same "Puppy" holds their puppy course (an isGroup Package), their puppy
// consult (a 1:1 Package) and the clicker they want every new owner to buy (a
// Product) at once. That is the entire point: a client asking "what have you
// got for a new puppy?" should get ONE answer, not three lists they have to
// join up themselves.
//
// DELIBERATELY NO COLOUR COLUMN. The house rule is that colour is the
// trainer's brand accent and it is rationed — a per-tag palette would put ten
// decorative hues on the client's browse screen fighting the one colour that
// is supposed to mean something. (Package.color is a different job: it tints
// the trainer's own calendar, which nobody else sees.)
model Tag {
  id        String @id @default(cuid())
  trainerId String
  name      String
  // Case-folded copy of `name`, and the column the uniqueness is actually on.
  // Postgres unique indexes compare case-SENSITIVELY, so ("Puppy", "puppy")
  // would both be accepted and the trainer would end up with two tags saying
  // the same word — which is the exact mess this feature exists to avoid.
  // Written by the API on every create and rename; never read for display.
  nameKey   String
  // The trainer's own arrangement, lowest first — same idea as
  // ProductCategory.order, and the order clients browse them in.
  order     Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainer TrainerProfile  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  items   TagAssignment[]

  @@unique([trainerId, nameKey])
  @@index([trainerId])
  @@map("tags")
}

// One thing carrying one tag.
//
// ONE join table with two nullable targets rather than a PackageTag table and
// a ProductTag table, because every read this feature exists for is "what is
// in this tag?" — and that has to come back as one mixed list, in one order,
// with one count. Two tables would make every one of those two queries plus a
// merge in application code, and the counts on the tag rail would be a sum the
// two halves could disagree about.
//
// The price is that Prisma cannot say "exactly one of these is set", so the
// migration adds a CHECK (num_nonnulls("packageId","productId") = 1) — the
// guarantee lives in the database, not in whichever route happens to write it.
//
// Cascade on all three sides deletes only THIS row: removing a tag drops its
// assignments and leaves every offering and product exactly where it was, and
// deleting a product drops its assignments and leaves the tag standing.
model TagAssignment {
  id        String  @id @default(cuid())
  tagId     String
  packageId String?
  productId String?

  createdAt DateTime @default(now())

  tag     Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  package Package? @relation(fields: [packageId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  // A thing carries a tag once. Postgres treats NULLs as distinct, so the
  // product rows (packageId NULL) never collide with each other under the
  // first index, and vice versa — which is what makes two of them work.
  @@unique([tagId, packageId])
  @@unique([tagId, productId])
  @@index([packageId])
  @@index([productId])
  @@map("tag_assignments")
}

// ─── Products (trainer shop) ─────────────────────────────────────────────────

// A trainer's own grouping for their shop — "Treats", "Guides", "Gear".
//
// It used to be a free-form string on each product, which was enough to GROUP
// by but not to manage: you could not create an empty one to fill later, could
// not rename it without editing every product in it, and had nowhere to keep
// the order they appear in. A row per category answers all three, and the old
// string is kept alongside so nothing that still reads it breaks.
model ProductCategory {
  id        String   @id @default(cuid())
  trainerId String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainer  TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  products Product[]

  // One "Treats" per business — a second would split the shelf in two.
  @@unique([trainerId, name])
  @@index([trainerId])
  @@map("product_categories")
}

model Product {
  id              String      @id @default(cuid())
  trainerId       String
  isSample        Boolean     @default(false)
  name            String
  description     String?     @db.Text
  kind            ProductKind @default(PHYSICAL)
  // Price in cents to avoid float issues. Null = unpriced / "Contact trainer".
  priceCents      Int?
  // Optional sale price, the same idea as Package.specialPriceCents. Null = not
  // on sale. When set it MUST be below priceCents, and it is the price actually
  // charged everywhere — client shop, checkout, invoice, membership grant. The
  // original stays in priceCents so the saving can be shown struck through.
  salePriceCents  Int?
  imageUrl        String?
  // Required for DIGITAL products — the file the customer downloads. Public URL
  // (e.g. Vercel Blob) or signed URL handed out at access time.
  downloadUrl     String?
  // The old free-form grouping. Still written and read so anything that has
  // not moved to categoryId keeps working; categoryId is the one to use.
  category        String?
  categoryId      String?
  // Units on hand. NULL = not tracked (services, digital downloads, anything
  // the trainer never runs out of) — the common case, and why this is nullable
  // rather than defaulting to 0, which would read as "sold out" for every
  // existing product. Counts down as items go out; the trainer tops it up.
  //
  // IGNORED once this product has variants: the counts then live on the
  // variant rows, because a harness in S/M/L is three shelves, not one. See
  // productInStock()/totalStock() in src/lib/stock.ts, which are the only
  // places that decide which of the two to read.
  stockCount      Int?
  featured        Boolean     @default(false) // surfaces on the client home dashboard
  active          Boolean     @default(true) // hide from clients without deleting
  order           Int         @default(0)
  // Xero revenue account code this product's invoice lines post to. Null = fall
  // back to the connection's default sales account (XeroConnection.salesAccountCode).
  xeroAccountCode String?
  // Per-item "require payment to book" override. null = inherit the trainer's
  // defaultRequirePayment; true = pay up front (Stripe); false = buy now, pay
  // later (raise an invoice, no upfront charge). Only bites when the trainer CAN
  // take cards — a payments-off trainer always invoices.
  requirePayment  Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainer         TrainerProfile   @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  // Deleting a category leaves its products alone — they fall back to
  // Uncategorised rather than vanishing from the shop with it.
  productCategory ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  requests        ProductRequest[]
  paymentItems    PaymentItem[]
  stockMovements  StockMovement[]
  variants        ProductVariant[]
  tags            TagAssignment[]

  @@index([trainerId])
  @@index([category])
  @@map("products")
}

// One buyable version of a product — "Small", "Large", "Red · Large".
//
// FLAT NAMED ROWS, not option axes. A Shopify-style ProductOption × value
// matrix is several times the work (an axis editor, a generated combination
// grid, partial-combination rules) and this is a dog trainer's shop: a harness
// in three sizes and a lead in two colours. The name IS the choice the client
// makes. Axes are the future upgrade if a trainer ever needs them, and this
// shape does not block it — a generator would write these same rows, with the
// axis values recorded alongside.
model ProductVariant {
  id        String @id @default(cuid())
  productId String
  // Tenant scope, denormalised off the product exactly as StockMovement does
  // it: a variant is read in stock and sales queries that must never be able
  // to cross businesses.
  trainerId String

  // What a client picks. Free text, because "1kg" and "Red · Large" are both
  // the same kind of answer to "which one?".
  name String
  // The trainer's own code, for their supplier or their shelf label. Never
  // shown to clients.
  sku  String?

  // NULL = inherit the product's. Five sizes at one price is the common case,
  // so it is entered once on the product and left alone here. Resolved in ONE
  // place — resolveVariantPricing() in src/lib/product-price.ts.
  priceCents     Int?
  salePriceCents Int?
  // NULL = the product's photo. Only worth setting when the colours differ.
  imageUrl       String?
  // NULL = the product's description. Tiptap HTML, like every other
  // description in the app — a trainer writes "fits 12–18kg, chest 45–60cm"
  // against the Medium and the product blurb keeps covering the rest. Resolved
  // in ONE place beside the prices — resolveVariantPresentation() in
  // src/lib/product-price.ts.
  description    String? @db.Text
  // Units on hand for THIS variant. NULL = not tracked, the same meaning it
  // has on Product. When a product has variants these are the counts that
  // matter and Product.stockCount is ignored.
  stockCount     Int?

  active Boolean @default(true)
  order  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product      Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  trainer      TrainerProfile   @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  requests     ProductRequest[]
  // History and sales outlive a deleted variant (SetNull on both sides), the
  // same rule the stock ledger already applies to clients and staff.
  movements    StockMovement[]
  paymentItems PaymentItem[]

  @@index([productId, order])
  @@map("product_variants")
}

// A client's standing request for a product. Stays PENDING and rolls forward
// onto each successive upcoming session until the trainer marks it FULFILLED
// (typically because they handed the item over at a session) or CANCELLED.
model ProductRequest {
  id        String               @id @default(cuid())
  clientId  String
  productId String
  // WHICH one they asked for. NULL = the product has no variants (or predates
  // them) — without this you cannot tell whether the harness to hand over is a
  // Small or a Large, which is the whole reason variants exist.
  variantId String?
  status    ProductRequestStatus @default(PENDING)

  // Optional notes from the client when they request (e.g. "for Bella, size L")
  note String? @db.Text

  // Set when trainer fulfils the request — links it to the session where it
  // was delivered, for the trainer's own records.
  fulfilledSessionId String?
  fulfilledAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client           ClientProfile    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  // A deleted variant blanks the pointer rather than deleting the order — the
  // client still asked for something, and the product line survives.
  variant          ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  fulfilledSession TrainingSession? @relation(fields: [fulfilledSessionId], references: [id], onDelete: SetNull)

  @@index([clientId, status])
  @@index([productId])
  @@map("product_requests")
}

// ─── Stock ledger ─────────────────────────────────────────────────────────────

enum StockMovementReason {
  RECEIVED // a delivery arrived
  SOLD // out the door to a client
  RETURNED // came back on the shelf
  DAMAGED
  LOST
  CORRECTION // a stocktake, or the trainer starting to count this at all
}

// One line of a product's stock history.
//
// `Product.stockCount` stays the running balance — ten places read it (the
// products table, the client shop, inStock(), stockLabel()) and a groupBy on
// every product-list render would be paid for on every page. So this is a
// LEDGER beside the balance, written in the SAME transaction as the balance
// change, exactly as a real inventory system keeps both.
//
// VARIANTS LANDED (size/colour SKUs under one product). variantId was here
// before anything wrote it, so no backfill was needed: NULL still means "the
// product's only SKU" and every row written before variants stays true.
// productId stays REQUIRED so a movement is always attributable to a product,
// and the BALANCE a movement describes is the variant's `stockCount` when
// variantId is set, the product's when it isn't.
model StockMovement {
  id        String  @id @default(cuid())
  productId String
  variantId String?
  // Tenant scope, denormalised off the product on purpose: a ledger query must
  // never be able to cross businesses, and history is read by trainer far more
  // often than it is written.
  trainerId String

  delta        Int // + on the shelf, − off it
  reason       StockMovementReason
  note         String?             @db.Text
  // What stockCount became. Lets the history render without replaying every
  // sum from the beginning, and makes drift between ledger and balance visible
  // rather than silent.
  balanceAfter Int?

  // Who it went to, when it was a sale; who did it, when a person did. Both
  // nullable — a Stripe webhook fulfilling an order has no user, and a
  // delivery booked in has no client.
  clientId String?
  userId   String?

  createdAt DateTime @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  trainer TrainerProfile  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  // History outlives the people in it: deleting a client or a staff member
  // blanks the attribution, it does not erase the movement. Same for a
  // retired variant — the units still moved.
  client  ClientProfile?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  user    User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([trainerId, createdAt])
  @@map("stock_movements")
}

// ─── Packages ─────────────────────────────────────────────────────────────────

model Package {
  id                       String      @id @default(cuid())
  trainerId                String
  // True for rows created by the trainer-facing "sample data" loader, so
  // clearSampleData() can remove them without touching the trainer's real data.
  isSample                 Boolean     @default(false)
  name                     String
  description              String?     @db.Text
  // Optional cover image (Vercel Blob URL), shown on the offering card + detail.
  imageUrl                 String?
  // The offering's DEFAULT venue, free text like ClassRun.location.
  //
  // The venue a class actually meets at lives on the ClassRun (a cohort can
  // move, and each session snapshots it), but an offering that hasn't been
  // scheduled yet has no run to hold it — so an address typed into the offering
  // form was accepted, saved nowhere, and gone on reload. It is stored here
  // instead, always, and a NEW run inherits it when it doesn't name its own.
  // Inheritance is create-time only: changing this never rewrites the venue of
  // a run that already exists (editing a single-run offering still syncs that
  // one run, which is what the form says it does — see syncOfferingRun).
  location                 String?
  sessionCount             Int         @default(3)
  weeksBetween             Int         @default(2) // gap between sessions, in weeks
  durationMins             Int         @default(60) // default duration applied to created sessions
  // Turnaround gap AFTER each session of this package — travel, clean-up, reset.
  // Nothing may be booked into it: a session's occupied window is
  // [scheduledAt, scheduledAt + durationMins + bufferMins). 0 = back-to-back.
  bufferMins               Int         @default(0)
  sessionType              SessionType @default(IN_PERSON)
  // Prices in cents to avoid float precision issues. specialPriceCents is an
  // optional discounted price the trainer can offer for promotions, etc.
  priceCents               Int? // null = unpriced
  specialPriceCents        Int? // null = no special price
  // What the trainer actually said, when they priced this by the session rather
  // than as a lump sum: "thirty dollars a session". null = priced as a total,
  // which is the original behaviour and still the common one.
  //
  // NOT a second price. `priceCents` above stays the authoritative total that
  // checkout, invoicing and every report read; this only records the intent, and
  // `resolvePackagePricing` (src/lib/session-pricing.ts) re-derives the total
  // from it on every save. That is what makes a four-session course re-price
  // itself when it becomes a six-session course, instead of keeping a total that
  // quietly stopped matching the figure that was typed.
  pricePerSessionCents     Int?
  // Optional schedule colour (Tailwind palette key, eg "blue"). When set,
  // sessions assigned to this package render in that colour on the calendar.
  color                    String?
  order                    Int         @default(0) // display order, lowest first
  // Optional default session form. When a session is opened with this package
  // and no form responses exist, the default form is auto-attached.
  defaultSessionFormId     String?
  // When false, suppress the SESSION_NOTES_REMINDER push for sessions in this
  // package. Some packages (e.g. drop-in classes) don't need a follow-up.
  // Defaults to true so existing packages keep firing reminders.
  requireSessionNotes      Boolean     @default(true)
  // ─── Group classes ──────────────────────────────────────────────────────
  // When isGroup, the package is a sellable class template. A trainer
  // schedules one or more ClassRuns (cohorts) off it; each run owns ONE
  // shared session series that many clients enrol into. isGroup=false
  // packages keep the 1:1 ClientPackage path untouched.
  isGroup                  Boolean     @default(false)
  // A puppy school / daycare: an ongoing, day-parted group offering run from
  // the Puppy School workspace. Implies isGroup + allowDropIn (each day-part is
  // a session a parent books like a drop-in) + sessionCount 0 (ongoing). The
  // flag lets the workspace and the week board find these without heuristics.
  isPuppySchool            Boolean     @default(false)
  // A one-off EVENT — a workshop, seminar or meet-up people buy a ticket to.
  // An event is a ClassRun like any other (same cohort, roster, capacity and
  // invoicing machinery, just a single occasion); this flag is the ONLY thing
  // that makes it an event rather than a class.
  //
  // It used to be inferred from the shape — isGroup && !allowDropIn &&
  // sessionCount === 1 && !recurrenceRule — but an ordinary group class that
  // runs once has exactly that shape, so those classes were filtered off
  // /classes and shown under /events instead. The kind is DECLARED at creation
  // (the /offerings/new?kind=oneoff route) and never re-derived, so editing an
  // offering can no longer change what it is. See lib/run-kind.ts.
  isEvent                  Boolean     @default(false)
  // A SERIES — a run of 1:1 consults with a pre-defined curriculum. The client
  // signs up to the whole thing; each step ("session 2 is loose-lead walking")
  // is defined up front on PackageSessionPlan, with its homework already on
  // PackageDefaultTask, and the sessions are scheduled individually.
  //
  // Labelling + routing ONLY, exactly like isPuppySchool and isEvent: a series
  // is an ordinary isGroup=false package and every 1:1 mechanism (ClientPackage,
  // assignment, invoicing) works on it untouched. The flag exists so the
  // offerings hub and the list pages can tell a series from a plain consult
  // without re-deriving it from shape — which is the mistake isEvent was created
  // to undo. Never infer it; it is declared at creation and read back verbatim.
  isSeries                 Boolean     @default(false)
  // Max enrolments per run (null = unlimited). A run may override this.
  capacity                 Int?
  // Allow clients to book a single session on its own (drop-in), at
  // dropInPriceCents. Per-session capacity; see enrollInRun.
  allowDropIn              Boolean     @default(false)
  dropInPriceCents         Int?
  // Repeating schedule for a class, as an iCalendar RRULE subset (e.g.
  // "FREQ=WEEKLY;BYDAY=TU;COUNT=8"). null / "" = one-off. Drives session
  // generation when a run is created. See lib/recurrence.ts.
  recurrenceRule           String?
  // Full runs accept a waitlist that auto-promotes on withdrawal.
  allowWaitlist            Boolean     @default(false)
  // Exposed on the public embed surface for client self-enrolment.
  publicEnrollment         Boolean     @default(false)
  // Client self-booking from their availability tab. clientSelfBook
  // opts the package in; selfBookRequiresApproval gates whether the
  // pick creates a pending BookingRequest (true) or books instantly
  // (false). Only meaningful when clientSelfBook is true.
  clientSelfBook           Boolean     @default(false)
  selfBookRequiresApproval Boolean     @default(true)
  /// The instant this offering starts being visible to CLIENTS. null — the
  /// default and what every existing row means — is "visible immediately".
  ///
  /// A trainer sets next term's classes up in November and does not want them
  /// on the booking screen until enrolments open. The alternative was building
  /// them the night before, or building them hidden and remembering to unhide,
  /// and both are how a term ends up half-listed.
  ///
  /// An INSTANT, not a @db.Date. The trainer picks a calendar day, but a
  /// calendar day means nothing without a zone: this repo has already shipped a
  /// bug where a DATE column compared against instants moved an NZ trainer's
  /// whole week. The day is resolved to midnight in the TRAINER's timezone at
  /// save time (startOfDayInTz), so every read is a plain instant comparison
  /// that cannot be got wrong.
  ///
  /// TRAINER-side this changes nothing — they see the offering exactly as
  /// before, marked "not yet showing". The gate is applied server-side in every
  /// client and public read; see lib/offering-visibility.ts, and never filter
  /// this in the browser.
  visibleFrom              DateTime?
  // Xero revenue account code this package's invoice lines post to. Null = fall
  // back to the connection's default sales account (XeroConnection.salesAccountCode).
  xeroAccountCode          String?
  // Per-item "require payment to book" override. null = inherit the trainer's
  // defaultRequirePayment; true = pay up front (Stripe); false = book now, pay
  // later (raise an invoice). Only bites when the trainer CAN take cards.
  requirePayment           Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainer            TrainerProfile       @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  assignments        ClientPackage[]
  classRuns          ClassRun[]
  sessionSlots       PackageSessionSlot[]
  ticketTiers        PackageTicketTier[]
  waitlistEntries    WaitlistEntry[]
  discounts          Discount[]
  defaultTasks       PackageDefaultTask[]
  sessionPlans       PackageSessionPlan[]
  commsFlowSteps     CommsFlowStep[]
  bookingRequests    BookingRequest[]
  bookingPages       BookingPage[]
  tags               TagAssignment[]
  defaultSessionForm SessionForm?         @relation("PackageDefaultSessionForm", fields: [defaultSessionFormId], references: [id], onDelete: SetNull)

  @@index([trainerId])
  @@index([defaultSessionFormId])
  // Every client-facing offering query carries the visibleFrom gate.
  @@index([trainerId, visibleFrom])
  @@map("packages")
}

// One repeating slot in a drop-in class's schedule — "Tuesdays 3–5pm at the
// park, $25, 8 spaces". A drop-in offering is a list of these rather than the
// single (sessionCount × weeksBetween) cadence the other kinds use, because
// each slot prices, caps, staffs and locates itself: a class can run Tuesday
// afternoons at one venue and every second Saturday at another, at different
// prices. Expanding a slot's recurrenceRule produces the actual
// TrainingSessions (see lib/recurrence.ts + createClassRun).
model PackageSessionSlot {
  id                    String    @id @default(cuid())
  packageId             String
  // Display / generation order — the order the cards appear in the editor.
  order                 Int       @default(0)
  // First occurrence. Null = start from the run's start date.
  startDate             DateTime?
  // 0 = Sunday … 6 = Saturday. The weekday the first occurrence lands on;
  // the recurrenceRule then governs how it repeats from there.
  day                   Int       @default(1)
  // Local wall-clock "HH:mm" — a class meets at 3pm regardless of DST.
  startTime             String    @default("15:00")
  endTime               String    @default("17:00")
  // Turnaround gap after each occurrence, snapshotted onto its sessions.
  gapMins               Int       @default(0)
  // Per-session capacity (null = inherit the run/package capacity).
  capacity              Int?
  // What ONE session of this slot costs. null = free.
  priceCents            Int?
  specialPriceCents     Int?
  xeroAccountCode       String?
  requirePayment        Boolean   @default(false)
  locationId            String?
  // iCalendar RRULE subset; '' / null = a single occurrence.
  recurrenceRule        String?
  // TrainerMembership ids running this slot's sessions.
  assignedMembershipIds String[]  @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  package  Package           @relation(fields: [packageId], references: [id], onDelete: Cascade)
  location Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  sessions TrainingSession[]

  @@index([packageId])
  @@index([locationId])
  @@map("package_session_slots")
}

// A ticket type for a one-off event — "Early bird $40, cap 20" / "General $60".
// Lives on the Package (the event's definition) rather than the run, the same
// way price and capacity do; a run inherits whatever the event sells.
model PackageTicketTier {
  id              String  @id @default(cuid())
  packageId       String
  order           Int     @default(0)
  name            String
  priceCents      Int? // null / 0 = free
  capacity        Int? // null = unlimited
  xeroAccountCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  package     Package           @relation(fields: [packageId], references: [id], onDelete: Cascade)
  // Who bought this ticket type. SetNull on the enrolment side, so retiring a
  // ticket type never deletes the people who already hold one.
  enrollments ClassEnrollment[]

  @@index([packageId])
  @@map("package_ticket_tiers")
}

model ClientPackage {
  id                   String    @id @default(cuid())
  packageId            String
  clientId             String
  startDate            DateTime
  assignedAt           DateTime  @default(now())
  // When true, the schedule auto-creates more sessions on the package's
  // cadence so the calendar always has ~6 weeks of sessions ahead.
  extendIndefinitely   Boolean   @default(false)
  // Manual flag the trainer ticks when they've sent the invoice for this
  // assignment outside PupManager (Xero/QBO/cash). Null = not invoiced yet.
  // Once we wire real billing this is what the financial layer keys off.
  invoicedAt           DateTime?
  // Set when this assignment was GRANTED by a recurring membership, so the
  // grant can be paused if that membership stops being paid for and restored
  // when it resumes. Null for every normal assignment, which is most of them.
  membershipPurchaseId String?
  // Access paused for non-payment. Deliberately a reversible timestamp and NOT
  // a delete: the whole point is that a successful retry restores everything
  // exactly as it was, and most failures are an expired card that gets
  // replaced within days. Sessions are left on the calendar so the trainer can
  // still see them — only the CLIENT's use of them is paused.
  suspendedAt          DateTime?

  package     Package           @relation(fields: [packageId], references: [id], onDelete: Cascade)
  client      ClientProfile     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sessions    TrainingSession[]
  paymentItem PaymentItem?

  @@index([clientId])
  @@index([packageId])
  @@index([membershipPurchaseId])
  @@map("client_packages")
}

// ─── Group classes ────────────────────────────────────────────────────────────

enum ClassRunStatus {
  SCHEDULED // created, may still be taking enrolments before it starts
  RUNNING // first session has happened
  COMPLETED // all sessions done
  CANCELLED // called off; sessions cancelled, enrolments closed
}

enum EnrollmentType {
  FULL // enrolled for the whole run from the start
  DROP_IN // joined mid-run, pays per remaining session
}

enum EnrollmentStatus {
  ENROLLED
  WAITLISTED
  WITHDRAWN
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  MAKEUP // attended a different run's session to make this one up
}

// A scheduled cohort of a group Package. Owns ONE shared TrainingSession
// series (sessions have classRunId set, clientId null). Capacity falls
// back to the package's when null here.
model ClassRun {
  id             String         @id @default(cuid())
  trainerId      String
  isSample       Boolean        @default(false)
  packageId      String
  name           String // e.g. "Spring Puppy Class"
  scheduleNote   String? // human cadence, e.g. "Tuesdays 6:00pm"
  startDate      DateTime
  capacity       Int? // per-run override of Package.capacity
  // Per-run override of Package.bufferMins (the gap before the next session).
  // NULL = inherit the package's value — same tri-state shape as `capacity`.
  bufferMins     Int?
  imageUrl       String? // optional cover image (Vercel Blob URL)
  // Where the class meets. Free text by design — a Google-picked address and
  // "the field behind the hall" are both valid answers. Copied onto each
  // generated session so a per-session override stays possible.
  location       String?
  status         ClassRunStatus @default(SCHEDULED)
  // Per-class "require payment to enrol" override. null = inherit the trainer's
  // defaultRequirePayment; true = pay up front (Stripe); false = enrol now, pay
  // later (raise an invoice). Only bites when the trainer CAN take cards.
  requirePayment Boolean?
  // Trainer-arranged display order within its section (classes / casual classes
  // / events), lowest first — the same order clients see in the booking flow.
  // Ties fall back to startDate, so a run that has never been dragged keeps the
  // old chronological behaviour.
  order          Int            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainer          TrainerProfile    @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  package          Package           @relation(fields: [packageId], references: [id], onDelete: Restrict)
  sessions         TrainingSession[]
  enrollments      ClassEnrollment[]
  assignedTrainers ClassRunTrainer[]
  commsFlowSteps   CommsFlowStep[]
  messageGroups    MessageGroup[]

  @@index([trainerId])
  @@index([packageId])
  @@map("class_runs")
}

// Join model: which team members (TrainerMembership rows) are assigned to run
// a ClassRun. A ClassRun belongs to one company (trainerId); this lets one or
// more of that company's members be tagged as the trainer(s) on it.
model ClassRunTrainer {
  id           String   @id @default(cuid())
  classRunId   String
  membershipId String
  createdAt    DateTime @default(now())

  classRun   ClassRun          @relation(fields: [classRunId], references: [id], onDelete: Cascade)
  membership TrainerMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([classRunId, membershipId])
  @@index([classRunId])
  @@index([membershipId])
  @@map("class_run_trainers")
}

// A client+dog's membership in a ClassRun. Replaces ClientPackage for the
// group path. Waitlist is a status + position, auto-promoted on withdrawal.
model ClassEnrollment {
  id               String           @id @default(cuid())
  classRunId       String
  clientId         String
  dogId            String?
  type             EnrollmentType   @default(FULL)
  status           EnrollmentStatus @default(ENROLLED)
  waitlistPosition Int? // set only while WAITLISTED
  // For DROP_IN (single-session model): the ONE session this drop-in is for.
  // They pay the flat per-session price, count against that session's capacity
  // only, and appear on that session's roster only. FULL enrolments leave this
  // null and attend every session.
  dropInSessionId  String?
  // For DROP_IN: the 1-based index of dropInSessionId, kept for display
  // ("dropped into session 3"). dropInSessionId is the source of truth.
  joinedAtIndex    Int?
  // Which ticket type they bought, for an event that sells several ("Early
  // bird" / "General"). Null on every other kind of run — those price off the
  // package's single price, which is what this used to assume for events too.
  ticketTierId     String?
  // How many places this one enrolment is for. A ticket can be bought several
  // at a time ("2 × General"); everything else is a single seat, hence the
  // default of 1 — it multiplies both the invoice and the capacity it uses up.
  quantity         Int              @default(1)
  // One enrolment ACTION that bought several ticket types at once ("3 General
  // + 3 VIP") is one row per type — each prices off its own tier and is capped
  // by its own tier — tied together by this shared id. It is what makes the
  // basket bill as ONE invoice with a line per ticket type instead of an
  // invoice each. Null for every single-ticket enrolment, which is every row
  // that existed before this.
  ticketGroupId    String?
  source           String           @default("TRAINER") // "TRAINER" | "SELF_SERVE"

  /// THIS CLIENT's write-up form for this class. Null = whatever the session or
  /// the class default says (see resolveSessionForm in lib/session-form).
  ///
  /// A class is one group but not one kind of client: a puppy on foundations and a
  /// dog in for reactivity need different questions answered, in the same room, on
  /// the same night. The session-level form couldn't express that — everyone got
  /// the same one.
  sessionFormId        String?
  // Mirrors ClientPackage.invoicedAt — manual until billing is wired.
  invoicedAt           DateTime?
  enrolledAt           DateTime  @default(now())
  withdrawnAt          DateTime?
  // Granted by a recurring membership — see ClientPackage.membershipPurchaseId.
  membershipPurchaseId String?
  // Access paused for non-payment. NOT withdrawnAt: withdrawing gives up the
  // seat and frees it for someone else, which is irreversible in any way that
  // matters. A pause keeps the seat — a client whose card is replaced two days
  // later must get their place back, not find it sold to somebody else.
  suspendedAt          DateTime?

  classRun      ClassRun            @relation(fields: [classRunId], references: [id], onDelete: Cascade)
  client        ClientProfile       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dog           Dog?                @relation(fields: [dogId], references: [id], onDelete: SetNull)
  dropInSession TrainingSession?    @relation("DropInSession", fields: [dropInSessionId], references: [id], onDelete: Cascade)
  ticketTier    PackageTicketTier?  @relation(fields: [ticketTierId], references: [id], onDelete: SetNull)
  attendance    SessionAttendance[]
  paymentItem   PaymentItem?
  sessionForm   SessionForm?        @relation("EnrollmentSessionForm", fields: [sessionFormId], references: [id], onDelete: SetNull)

  // dropInSessionId is part of the key so a client can drop into SEVERAL
  // sessions of the same run — one row each. Postgres treats NULLs as distinct,
  // so this index never fires on a FULL enrolment (dropInSessionId is null);
  // the real rule lives in code. For a plain class that rule is still
  // one-per-client-and-dog (enrollInRun). For a TICKETED event it is
  // one-per-client-and-dog PER TICKET TYPE (enrollInRunTickets), because
  // "3 General + 3 VIP" is genuinely two holdings at two prices.
  @@unique([classRunId, clientId, dogId, dropInSessionId])
  @@index([classRunId])
  @@index([clientId])
  @@index([dropInSessionId])
  @@index([ticketTierId])
  @@index([ticketGroupId])
  @@index([membershipPurchaseId])
  @@index([sessionFormId])
  @@map("class_enrollments")
}

// Per-enrollee record for one shared class session: the roster grid AND
// the per-dog in-class note/scores. scores is a free JSON bag so the
// trainer can score whatever they like without a migration.
model SessionAttendance {
  id           String           @id @default(cuid())
  sessionId    String
  enrollmentId String
  status       AttendanceStatus @default(PRESENT)
  note         String?          @db.Text
  scores       Json             @default("{}")
  // This client's own filled report for the session (per "each client has its
  // own form"): { formId, answers: {qid:val}, images: {qid:[url]}, intro,
  // closing }. Null = not written yet.
  report       Json?
  // Draft vs sent for the report above. Null = saved draft, not yet visible to
  // the client; set = recap sent (client notified + visible).
  reportSentAt DateTime?
  markedAt     DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  session    TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollment ClassEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, enrollmentId])
  @@index([sessionId])
  @@index([enrollmentId])
  @@map("session_attendance")
}

// ─── General scheduling waitlist ──────────────────────────────────────────────
// Trainer-wide list of people the trainer wants to take on but has no
// availability for yet. Distinct from the per-ClassRun waitlist (which
// means a specific cohort is full). The subject can be an existing client
// OR a prospect (contact snapshot, like an unlinked Enquiry).

enum WaitlistStatus {
  WAITING
  CONTACTED // trainer has reached out, not yet booked
  SCHEDULED // converted into a booking
  REMOVED // no longer waiting (declined / went elsewhere)
}

model WaitlistEntry {
  id                 String         @id @default(cuid())
  trainerId          String
  // Optional link to an existing client. When null this is a prospect —
  // name is always set; email/phone are the contact snapshot.
  clientId           String?
  name               String
  email              String?
  phone              String?
  // What they want. packageId = a specific package of interest (optional);
  // request = freeform ("6-week reactive course, weekday evenings").
  packageId          String?
  request            String?        @db.Text
  sessionType        SessionType?
  // Time preferences for matching to openings. preferredDays holds
  // ISO weekday numbers (1=Mon … 7=Sun); empty = any day. The time
  // window mirrors AvailabilitySlot's "HH:MM" 24-hr strings.
  preferredDays      Int[]          @default([])
  preferredTimeStart String? // "HH:MM" or null = any
  preferredTimeEnd   String? // "HH:MM" or null = any
  earliestStart      DateTime?      @db.Date
  notes              String?        @db.Text
  // Manual ordering — lower = higher priority (top of the list).
  priority           Int            @default(0)
  status             WaitlistStatus @default(WAITING)
  contactedAt        DateTime?
  convertedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  client  ClientProfile? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  package Package?       @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([trainerId, status])
  @@index([clientId])
  @@index([packageId])
  @@map("waitlist_entries")
}

// ─── Client self-booking ──────────────────────────────────────────────────────
// A client self-booked a package from their availability tab. For
// approval-required packages this row is PENDING until the trainer
// confirms (then it spawns a ClientPackage + sessions). Instant-book
// packages skip this model entirely and create the booking directly.

enum BookingRequestStatus {
  PENDING
  CONFIRMED
  DECLINED
}

model BookingRequest {
  id                       String               @id @default(cuid())
  trainerId                String
  clientId                 String
  packageId                String
  dogId                    String?
  // Proposed session datetimes (ISO strings), generated from the
  // client's chosen start on the package cadence. The trainer can
  // adjust on the calendar after confirming.
  sessionDates             Json                 @default("[]")
  status                   BookingRequestStatus @default(PENDING)
  // The booking page this request came from (soft ref), so confirming it can
  // stamp the resulting sessions with the page for BEFORE/AFTER automations.
  bookingPageId            String?
  note                     String?              @db.Text
  // Set on confirm — links to the created assignment for traceability.
  resultingClientPackageId String?
  createdAt                DateTime             @default(now())
  decidedAt                DateTime?

  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  client  ClientProfile  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  package Package        @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([trainerId, status])
  @@index([clientId])
  @@map("booking_requests")
}

// ─── Trainer gamification ─────────────────────────────────────────────────────
// Engagement streak for trainers (distinct from the client-facing
// Achievement system). One row per trainer per ISO week in which they
// did a qualifying "meaningful work action". The streak is consecutive
// active weeks, derived from these rows. Badge catalogue lives in code
// (lib/trainer-streak.ts, like NOTIFICATION_TYPES); only awards persist.

model TrainerActivityWeek {
  id              String   @id @default(cuid())
  trainerId       String
  // ISO week key, e.g. "2026-W20" (lexically sortable within a year;
  // streak math uses a parsed week index, not string order).
  isoWeek         String
  firstActivityAt DateTime @default(now())

  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@unique([trainerId, isoWeek])
  @@index([trainerId])
  @@map("trainer_activity_weeks")
}

model TrainerBadgeAward {
  id        String   @id @default(cuid())
  trainerId String
  // Stable key from the in-code badge catalogue (e.g. "streak_4w",
  // "clients_10", "sessions_50").
  badgeKey  String
  awardedAt DateTime @default(now())

  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@unique([trainerId, badgeKey])
  @@index([trainerId])
  @@map("trainer_badge_awards")
}

// ─── Locations library ────────────────────────────────────────────────────────

// A reusable place the trainer works from — a training field, a client's home
// area, a hall they hire. Kept as a small library the trainer curates once, then
// picks from when creating packages, classes, sessions etc. so they don't retype
// the same address every time.
model Location {
  id           String               @id @default(cuid())
  trainerId    String
  name         String
  address      String? // free text / Google-picked address
  imageUrl     String?
  description  String?              @db.Text
  order        Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  trainer      TrainerProfile       @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  sessionSlots PackageSessionSlot[]

  @@index([trainerId])
  @@map("locations")
}

// ─── Session report forms ─────────────────────────────────────────────────────

// Trainer-defined questionnaire that can be attached to any TrainingSession to
// capture a structured report. Questions live as a JSON array so the trainer
// can reorder/add/remove without schema migrations:
//   [{ id, label, type: 'SHORT_TEXT'|'LONG_TEXT'|'NUMBER'|'RATING_1_5', required }]
model SessionForm {
  id              String  @id @default(cuid())
  trainerId       String
  isSample        Boolean @default(false)
  name            String
  description     String? @db.Text
  introText       String? @db.Text // shown above the questions during fill + on the report
  closingText     String? @db.Text // shown below the questions during fill + on the report
  // Visual treatment for the client-facing report. backgroundUrl wins over
  // backgroundColor when both are set.
  backgroundColor String? // hex/CSS colour, e.g. "#fef3c7"
  backgroundUrl   String? // public image URL, applied as a tiled cover
  questions       Json    @default("[]")
  order           Int     @default(0)
  // When false the form is a draft — hidden from the trainer's session-form
  // picker. New defaults seeded by the onboarding init helper start as drafts
  // so trainers review them before they're usable in real sessions.
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainer            TrainerProfile        @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  responses          SessionFormResponse[]
  defaultForPackages Package[]             @relation("PackageDefaultSessionForm")
  /// Clients whose write-up on a class uses THIS form rather than the class default.
  forEnrollments     ClassEnrollment[]     @relation("EnrollmentSessionForm")

  @@index([trainerId])
  @@map("session_forms")
}

// One trainer-filled response per (session, form). A session can have many
// responses (multiple forms attached). `answers` is a JSON object keyed by
// question id → string (we store everything as text; rendering interprets it).
model SessionFormResponse {
  id               String  @id @default(cuid())
  sessionId        String
  formId           String
  answers          Json    @default("{}")
  // Per-question image lists, keyed by question id → string[] of URLs
  imagesByQuestion Json    @default("{}")
  // Trainer-authored top/bottom messages for the report. Optional and
  // independent of the form template's introText/closingText (which act as
  // suggested defaults the trainer can copy in).
  introMessage     String? @db.Text
  closingMessage   String? @db.Text

  // Draft vs sent. Null = the trainer has saved a draft the client cannot see
  // yet. Set = the recap has been sent (client notified + visible). Saving a
  // note leaves this null; the explicit "send" action stamps it.
  sentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  form    SessionForm     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([sessionId, formId])
  @@index([sessionId])
  @@index([formId])
  @@map("session_form_responses")
}

// ─── Training Templates ───────────────────────────────────────────────────────

model TrainingTemplate {
  id          String  @id @default(cuid())
  trainerId   String
  name        String
  description String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  tasks   TemplateTask[]

  @@map("training_templates")
}

model TemplateTask {
  id          String  @id @default(cuid())
  templateId  String
  dayOffset   Int // day 1, 2, 3... from program start
  title       String
  description String? @db.Text
  repetitions Int?
  videoUrl    String?
  order       Int     @default(0)

  template TrainingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("template_tasks")
}

// ─── Messaging ────────────────────────────────────────────────────────────────

model Message {
  id                  String         @id @default(cuid())
  channel             MessageChannel
  clientId            String // the client this message thread relates to
  senderId            String
  body                String         @db.Text
  // Sanitized HTML body for messages composed in the rich-text editor (e.g. an
  // emailed announcement logged to the thread). Null = plain `body` only.
  bodyHtml            String?        @db.Text
  readAt              DateTime?
  // Set once the deferred-email fallback has been sent (or deliberately skipped)
  // for this message, so the message-email-fallback cron never double-emails.
  emailFallbackSentAt DateTime?

  createdAt DateTime @default(now())

  client ClientProfile @relation("ClientMessages", fields: [clientId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id])

  @@index([clientId])
  @@index([senderId])
  @@index([createdAt])
  // Hot path for the fallback cron: unread, un-emailed messages by age.
  @@index([channel, readAt, emailFallbackSentAt, createdAt])
  @@map("messages")
}

// ─── Group messaging ──────────────────────────────────────────────────────────
//
// A group is a THREAD, not a fan-out. It sits in the messages list beside the
// 1:1 client threads and you post into it over time — Facebook/WhatsApp group
// semantics, not "send once to many". See docs/plan-group-messaging.md §2(b).
//
// These are DELIBERATELY separate models from Message. Making Message.clientId
// nullable and bolting a groupId on would silently change the meaning of every
// existing query — the client-list query on the messages screen, the unread
// _count, countUnreadMessages(), the SSE poll and the email-fallback cron all
// assume a message has exactly ONE reader, which is what makes the single
// `readAt` column work. A group has N readers. So groups carry their own read
// state (per-participant lastReadAt watermark) and 1:1 messaging is left
// exactly as it was.

enum MessageGroupMode {
  // Trainer/staff posts go to everyone; a client's reply is seen ONLY by the
  // trainer's team. Members never see each other. No consent step needed —
  // nothing about one client is disclosed to another.
  BROADCAST
  // Everyone sees everyone. This makes dog owners visible to each other, which
  // is a disclosure they did not agree to when they handed details to a
  // trainer — so it is opt-in per client, per group, and default off.
  COMMUNITY
}

enum MessageGroupScope {
  MANUAL // hand-picked clients
  ALL_CLIENTS // every active client of this business
  CLASS_RUN // everyone enrolled on a ClassRun
  PACKAGE // everyone holding a ClientPackage for a Package
  MEMBERSHIP // everyone with an active MembershipPurchase
}

enum MessageGroupRole {
  OWNER // the business owner — always a moderator
  STAFF // a team member
  CLIENT // a dog owner
}

// Who can see one post. This is the ONE field the two modes differ by, rather
// than two code paths: in BROADCAST a client's reply is written TRAINER_ONLY,
// in COMMUNITY everything is EVERYONE.
enum GroupMessageVisibility {
  EVERYONE
  TRAINER_ONLY
}

model MessageGroup {
  id              String            @id @default(cuid())
  trainerId       String
  // Shown in the messages list, so it is required. Defaulted from the source
  // (the class name, "Everyone") at creation and editable afterwards.
  name            String
  mode            MessageGroupMode
  scope           MessageGroupScope
  // Whichever the scope points at. classRunId is a real FK (SetNull) so a
  // deleted class doesn't take its group's history with it.
  classRunId      String?
  packageId       String?
  membershipId    String?
  // CLASS_RUN only — whether the waitlist counts as members. The trainer
  // chooses this when creating the group; it is not a default.
  includeWaitlist Boolean           @default(false)
  // Overrides a muted push preference, same rule comms flows use.
  important       Boolean           @default(false)
  // Locked by the trainer: readable, no new posts.
  archivedAt      DateTime?
  // Denormalised so the merged messages list can sort threads and groups
  // together by activity without a correlated subquery per group.
  lastMessageAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainer      TrainerProfile            @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  classRun     ClassRun?                 @relation(fields: [classRunId], references: [id], onDelete: SetNull)
  participants MessageGroupParticipant[]
  messages     GroupMessage[]

  @@index([trainerId, lastMessageAt])
  @@map("message_groups")
}

// One person's membership of one group. A person can be in many groups — the
// unique is on the PAIR, deliberately, and nothing may narrow it to userId.
model MessageGroupParticipant {
  id              String           @id @default(cuid())
  groupId         String
  // The underlying User — the identity that reads and posts. Always set.
  userId          String
  // The ClientProfile this membership came from, for a dog owner. Null for
  // trainer/staff participants.
  clientProfileId String?
  role            MessageGroupRole
  // The ONLY identity other members ever see. First name by default; a client
  // can change it for that group. Never the login email, never the phone,
  // never an address — making it a stored column rather than a join is what
  // makes that promise structural instead of something every query must
  // remember.
  displayName     String
  invitedAt       DateTime         @default(now())
  // Null = invited but not accepted. THIS is the opt-in. A COMMUNITY group
  // leaves it null until the client agrees; a BROADCAST group sets it at
  // creation, because nothing about one member is exposed to another.
  joinedAt        DateTime?
  // No longer a member. Their posts stay in the thread but render as
  // "Removed member" — a tombstone, never a hole in the conversation.
  leftAt          DateTime?
  // Set ONLY when the person themselves left, or a moderator removed them —
  // never when the roster simply changed. This is what makes leaving STICK:
  // the audience refresh will happily re-add someone the roster dropped and
  // later restored, but must never silently drag back someone who walked out.
  // Two columns because "you withdrew from the class" and "I don't want to be
  // in this group" are different facts and only one of them is a choice.
  optedOutAt      DateTime?
  // Read WATERMARK. Replaces Message.readAt, which is a single timestamp and
  // cannot express "read" for N people (and is also the email-fallback
  // trigger). One column per person beats an N×M read table.
  lastReadAt      DateTime?
  mutedAt         DateTime?

  createdAt DateTime @default(now())

  group  MessageGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  client ClientProfile? @relation(fields: [clientProfileId], references: [id], onDelete: SetNull)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@index([clientProfileId])
  @@map("message_group_participants")
}

model GroupMessage {
  id         String                 @id @default(cuid())
  groupId    String
  senderId   String
  body       String                 @db.Text
  bodyHtml   String?                @db.Text
  visibility GroupMessageVisibility @default(EVERYONE)
  // The post being answered. A broadcast is an open question and the replies
  // are just sentences — no structure is imposed on them — but a group holding
  // three broadcasts still has to say which reply belongs to which, and this
  // is the only thing that can.
  replyToId  String?
  // Moderation tombstone — never hard-deleted, so the thread doesn't silently
  // rewrite itself around a removed post.
  deletedAt  DateTime?

  createdAt DateTime @default(now())

  group   MessageGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender  User           @relation(fields: [senderId], references: [id])
  replyTo GroupMessage?  @relation("GroupMessageReplies", fields: [replyToId], references: [id], onDelete: Cascade)
  replies GroupMessage[] @relation("GroupMessageReplies")

  @@index([groupId, createdAt])
  @@index([senderId])
  // The responses view: every reply to one broadcast, by person.
  @@index([replyToId])
  @@map("group_messages")
}

// ─── Notifications ────────────────────────────────────────────────────────────

// Dedup log for client session reminders — one row per (session, client, lead)
// so the cron never resends the same reminder.
model ClientReminderSent {
  id          String   @id @default(cuid())
  sessionId   String
  userId      String
  leadMinutes Int
  sentAt      DateTime @default(now())

  @@unique([sessionId, userId, leadMinutes])
  @@index([sessionId])
  @@map("client_reminders_sent")
}

model Notification {
  id        String            @id @default(cuid())
  userId    String
  title     String
  body      String
  // Optional category + deep link so the feed can group/route. Null = legacy.
  type      NotificationType?
  link      String?
  readAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([userId])
  @@map("notifications")
}

// ─── Custom Client Fields ─────────────────────────────────────────────────────

model CustomField {
  id         String          @id @default(cuid())
  trainerId  String
  isSample   Boolean         @default(false)
  label      String
  type       CustomFieldType
  required   Boolean         @default(false)
  // Whether this field appears in (and is required for) the quick-add contact
  // form. `required` above governs the full create form / intake.
  inQuickAdd Boolean         @default(false)
  options    Json? // string[] for DROPDOWN
  order      Int             @default(0)
  category   String? // optional grouping label
  appliesTo  String          @default("OWNER") // "OWNER" | "DOG"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainer TrainerProfile     @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  values  CustomFieldValue[]

  @@index([trainerId])
  @@map("custom_fields")
}

model CustomFieldValue {
  id       String  @id @default(cuid())
  fieldId  String
  clientId String
  dogId    String? // set when field appliesTo = "DOG"
  value    String  @db.Text

  updatedAt DateTime @updatedAt

  field  CustomField   @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  client ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([fieldId, clientId, dogId])
  @@map("custom_field_values")
}

// ─── Subscription Plans ───────────────────────────────────────────────────────

model SubscriptionPlan {
  id                           String  @id @default(cuid())
  name                         String
  description                  String? @db.Text
  priceMonthly                 Float
  maxClients                   Int? // null = unlimited
  featureFlags                 Json    @default("{}")
  isActive                     Boolean @default(true)
  // Stripe Price ID this plan maps to (e.g. price_1Abc…). Null while a
  // plan exists in our DB but hasn't been wired to Stripe yet — the
  // checkout flow filters those out so the trainer can't pick a plan
  // we can't actually charge for. Treated as the NZD default; per-
  // currency overrides live in stripePriceIdsByCurrency.
  stripePriceId                String? @unique
  // Per-currency Stripe Price IDs. Shape: { "AUD": "price_…", "USD": "price_…" }.
  // The /billing/setup page lets the trainer pick a currency; we look
  // up the matching price here at Checkout time. If the chosen
  // currency has no entry, we fall back to stripePriceId (NZD) and
  // surface that to the trainer in the UI.
  stripePriceIdsByCurrency     Json    @default("{}")
  // Stripe TEST-mode price IDs (sandbox), mirroring the live columns above.
  // Sandbox trainers (e.g. the demo) resolve against these instead.
  stripePriceIdTest            String?
  stripePriceIdsByCurrencyTest Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainers TrainerProfile[]

  @@map("subscription_plans")
}

// ─── Billing Items (seats + add-ons) ──────────────────────────────────────────
// The Core software base lives in SubscriptionPlan (id "core"). Everything
// that stacks on top of it — the per-seat "extra trainer" charge and the
// toggleable add-ons — is a BillingItem. Each carries the same Stripe price
// shape as SubscriptionPlan (NZD default in `stripePriceId`, per-currency
// overrides in `stripePriceIdsByCurrency`) so the price-resolution logic in
// lib/billing.ts is shared. Prices mirror src/lib/pricing.ts / the marketing
// site — the website is the source of truth.

enum BillingItemKind {
  SEAT
  ADDON
}

model BillingItem {
  // Stable string ids matching src/lib/pricing.ts: "seat", "achievements",
  // "shop", "ai". Used as the join key on TrainerAddon and the lookup key
  // when building Checkout line items.
  id                           String          @id
  kind                         BillingItemKind
  name                         String
  description                  String?         @db.Text
  // NZD reference price — display/sanity only; Stripe is authoritative.
  priceMonthly                 Float
  // Canonical (NZD) Stripe Price ID; per-currency overrides below. Null
  // until wired to Stripe. Same semantics as SubscriptionPlan.
  stripePriceId                String?         @unique
  // Shape: { "AUD": "price_…", "USD": "price_…" }. Falls back to
  // stripePriceId (NZD) when a currency has no entry.
  stripePriceIdsByCurrency     Json            @default("{}")
  // Stripe TEST-mode price IDs (sandbox), mirroring the live columns above.
  stripePriceIdTest            String?
  stripePriceIdsByCurrencyTest Json            @default("{}")
  isActive                     Boolean         @default(true)
  // Display order in the /billing/setup add-on list.
  sortOrder                    Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainerAddons TrainerAddon[]

  @@map("billing_items")
}

// One row per (trainer, add-on) the trainer has switched on. The seat
// charge is NOT tracked here — it's a quantity on TrainerProfile.seatCount.
// stripeSubscriptionItemId lets us target the exact line item later for
// pro-rata add/remove ("toggle any add-on anytime", phase 2).
model TrainerAddon {
  id                       String    @id @default(cuid())
  trainerId                String
  itemId                   String // BillingItem.id, kind = ADDON
  // Stripe subscription item id for this add-on's line. Null until the
  // webhook reconciles the subscription after checkout.
  stripeSubscriptionItemId String?   @unique
  // False = toggled off but row kept for history. The active set drives
  // feature gating + billing.
  active                   Boolean   @default(true)
  // Admin-granted free comp: the trainer gets the add-on at no cost for a
  // preview/promo window. Never billed (skipped in the Stripe path) and
  // protected from the webhook's reconciliation sweep, which would otherwise
  // deactivate any row that isn't a live subscription line item.
  grantedByAdmin           Boolean   @default(false)
  // When the access lapses. Null = no expiry (a permanent comp or a normal
  // paid/free toggle). Once past, gating treats the row as inactive — the
  // add-on silently switches off, the trainer is never charged.
  expiresAt                DateTime?
  // When the "your trial ends soon" reminder went out for the CURRENT expiresAt.
  // Reset to null whenever the admin changes the expiry, so an extended grant
  // re-arms the reminder. The cron only emails when this is null.
  expiryReminderSentAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  item    BillingItem    @relation(fields: [itemId], references: [id])

  @@unique([trainerId, itemId])
  @@index([trainerId])
  @@map("trainer_addons")
}

// ─── Client→Trainer payments (Flow B, Stripe Connect Express) ─────────────────
// A Payment is one hosted-Checkout charge a client made to a trainer, settled on
// the platform account as a *destination charge* (transfer_data.destination =
// the trainer's Connect account, application_fee_amount = our platform cut).
// Stripe handles the split + payout; we just record the result and fulfil what
// was bought. PaymentItem rows link a payment to the things it created
// (ClientPackage / TrainingSession / Product / ClassEnrollment). This is wholly
// separate from the trainer's own subscription to PupManager.

enum PaymentStatus {
  PENDING // Checkout session created, not yet paid
  PAID // payment_intent succeeded
  FAILED
  REFUNDED // fully refunded
  PARTIALLY_REFUNDED
  DISPUTED // chargeback opened
  CANCELLED // session expired / abandoned
}

enum PurchasableKind {
  PACKAGE // → ClientPackage created/activated
  SESSION // → single TrainingSession (booking-page slot)
  PRODUCT // → Product purchase
  CLASS_ENROLLMENT // → ClassEnrollment (group / drop-in)
  MEMBERSHIP // → a combo membership: fulfilment grants each included item + writes MembershipPurchase
}

// Tracks whether a Payment's invoice has been mirrored into the trainer's Xero
// org. ERROR keeps the last failure retriable/surfaceable; NOT_SYNCED covers
// both "trainer not connected" and "not attempted yet".
enum XeroSyncStatus {
  NOT_SYNCED
  SYNCED
  ERROR
}

model Payment {
  id        String  @id @default(cuid())
  trainerId String
  // ClientProfile.id — null for a prospect paying before conversion.
  clientId  String?

  // Stripe identifiers. The Checkout Session/PaymentIntent live on the platform
  // account; the resulting charge sits on the connected account.
  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique
  stripeChargeId          String?
  // Denormalised acct_… that received the funds (survives trainer edits).
  connectAccountId        String

  // Money in minor units. amountTotal = what the client paid.
  amountTotal          Int
  currency             String // ISO 4217 lower-case, matches payoutCurrency at sale time
  applicationFeeAmount Int // our platform fee, minor units
  // Stripe's processing ("credit card") fee for this charge, minor units. Read
  // from the charge's balance_transaction on payment success and shown on the
  // invoice/earnings breakdown (gross − card fee − platform fee = net). Null
  // until the webhook fills it in.
  stripeFeeAmount      Int?
  amountRefunded       Int           @default(0)
  status               PaymentStatus @default(PENDING)
  // Which Stripe mode this lived in (mirrors TrainerProfile.sandboxBilling at
  // sale time) so webhooks/refunds reach for the right key pair.
  sandbox              Boolean       @default(false)
  // Human description of what was bought, denormalised for the earnings list so
  // deleting a Package/Product never orphans payment history.
  description          String?

  // Xero sync. xeroInvoiceId is set once the ACCREC invoice exists in the
  // trainer's org; xeroPaymentId once the payment has been applied against it
  // (presence = reconciled, so re-delivery is a no-op). status + error track the
  // last attempt for retry/surfacing.
  xeroInvoiceId  String?
  xeroPaymentId  String?
  xeroSyncStatus XeroSyncStatus @default(NOT_SYNCED)
  xeroSyncError  String?

  // The three Xero BankTransactions that make the Stripe clearing account
  // balance (see XeroConnection): the client-paid card surcharge RECEIVEd into
  // clearing (income), and the two fees SPENT out of it. Each id's presence is
  // the idempotency guard, so a webhook re-delivery never double-posts.
  xeroSurchargeTxnId   String? // RECEIVE — card surcharge the client paid (income)
  xeroFeeTxnId         String? // SPEND  — Stripe's processing fee
  xeroPlatformFeeTxnId String? // SPEND  — PupManager's application fee

  createdAt DateTime  @default(now())
  paidAt    DateTime?
  updatedAt DateTime  @updatedAt

  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  client  ClientProfile? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  items   PaymentItem[]
  refunds Refund[]

  @@index([trainerId, status])
  @@index([clientId])
  @@map("payments")
}

model PaymentItem {
  id          String          @id @default(cuid())
  paymentId   String
  kind        PurchasableKind
  // Snapshot of name + unit price at sale time (history survives edits/deletes).
  description String
  unitAmount  Int
  quantity    Int             @default(1)

  // Links to the fulfilled rows, set on payment success. One-to-one for the
  // session/package/enrollment a payment created; product can repeat across
  // payments so it's a plain FK.
  clientPackageId   String? @unique
  trainingSessionId String? @unique
  productId         String?
  // Which variant was paid for. NULL = a product with no variants, or a line
  // that isn't a catalogue product at all (a card surcharge, an invoice
  // settlement). "They bought a harness" is not enough to pick one off the
  // shelf; "they bought the Large" is.
  variantId         String?
  classEnrollmentId String? @unique
  // What to create on payment success, captured at checkout time, e.g.
  // { packageId, slotIso, dogId, bookingPageId, quantity }.
  intent            Json?

  payment         Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  clientPackage   ClientPackage?   @relation(fields: [clientPackageId], references: [id], onDelete: SetNull)
  trainingSession TrainingSession? @relation(fields: [trainingSessionId], references: [id], onDelete: SetNull)
  product         Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant         ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  classEnrollment ClassEnrollment? @relation(fields: [classEnrollmentId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@map("payment_items")
}

model Refund {
  id             String   @id @default(cuid())
  paymentId      String
  stripeRefundId String   @unique
  amount         Int // minor units
  reason         String? // trainer note or Stripe reason
  status         String // "pending" | "succeeded" | "failed"
  createdAt      DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("refunds")
}

// ─── Invoices (payment-method-agnostic receivables) ───────────────────────────
// A trainer's invoice to a client that is NOT tied to Stripe. Lets trainers who
// bill by bank transfer and/or reconcile in Xero raise and track what a client
// owes, without any Connect setup. Wholly distinct from the Stripe-only
// `Payment` model above (which powers card checkout, refunds, Connect payouts):
// an Invoice is a receivable, created UNPAID the moment a priced package/product
// is assigned. It can later be linked to a settled Stripe `Payment` via
// `paymentId` (Phase 2 — Stripe pay-link on send). Idempotency key is
// (trainerId, clientId, sourceType, sourceId), so an assignment is invoiced once.
model Invoice {
  id        String @id @default(cuid())
  trainerId String
  clientId  String

  // Money in minor units; currency is ISO 4217 lower-case (matches the
  // trainer's payoutCurrency at issue time). amountCents is the cached total
  // (sum of line amounts); amountPaidCents is how much has been settled so far
  // (kept in step with Xero via inbound reconciliation — supports partials).
  amountCents     Int
  amountPaidCents Int    @default(0)
  currency        String

  // "UNPAID" | "PARTIAL" | "PAID" | "CANCELLED". A plain string (not an enum) so
  // states can grow without a schema migration. PARTIAL = 0 < paid < total.
  status String @default("UNPAID")

  // Human label for the invoice ("6-Week Puppy Course").
  description String?

  // What generated this receivable, for idempotency + back-reference.
  // sourceType: "PACKAGE" | "PRODUCT" | "MANUAL"; sourceId: the originating
  // clientPackageId / productId.
  sourceType String?
  sourceId   String?

  // When the client was actually emailed/notified about the invoice. Null =
  // created but not yet sent — still fully reconcilable, just not delivered.
  // paidAt stamps settlement (Phase 2 reconciliation).
  sentAt DateTime?
  paidAt DateTime?

  // Xero mirror. Best-effort push on creation; status/error track the last
  // attempt for retry + surfacing (same shape as Payment's Xero fields).
  xeroInvoiceId  String?
  xeroSyncStatus String? // "SYNCED" | "ERROR" | null (not attempted / not connected)
  xeroSyncError  String?

  // Soft link to the Stripe `Payment` that settled this by card (Phase 2). A
  // plain column — deliberately NOT a Prisma relation — so the existing Stripe
  // `Payment` model stays exactly as-is.
  //
  // MANY invoices to ONE payment, on purpose. A single card payment routinely
  // covers several receivables: two dogs on one class, or four drop-in dates
  // booked together. This was `@unique` until 2026-07-30, which meant the first
  // invoice claimed the payment and every other update failed the constraint —
  // swallowed by the catch in settleInvoiceFromPayment, so invoices 2..N sat on
  // "Sent" forever and the trainer marked them paid by hand.
  paymentId        String?
  // How a manually-recorded payment arrived: BANK_TRANSFER | CASH | OTHER.
  // Null for card payments (they have a Payment row) and for unpaid invoices.
  // The reference is free text — a bank statement line, a receipt number —
  // whatever helps the trainer reconcile it later.
  paymentMethod    String?
  paymentReference String?
  // Set on the ORIGINALS when several invoices are combined into one, so the
  // history stays traceable instead of the old ones simply vanishing.
  mergedIntoId     String?

  // Unguessable public pay-token — the key to the no-login pay page at
  // /pay/<payToken>. cuid2 (high entropy) so the URL can't be enumerated;
  // auto-generated for every invoice, backfilled for pre-existing rows.
  payToken String? @unique @default(cuid(2))

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainer TrainerProfile    @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  client  ClientProfile     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lines   InvoiceLineItem[]

  @@index([trainerId, status])
  @@index([clientId])
  @@index([sourceType, sourceId])
  // Replaces the old unique index: still needs to be fast to find every
  // invoice a given payment settled, it just isn't limited to one any more.
  @@index([paymentId])
  @@map("invoices")
}

// A single line on an Invoice. Invoices are multi-line; `Invoice.amountCents` is
// the cached SUM of every line's `amountCents`, and each line's `amountCents` is
// the cached `quantity * unitAmountCents`. Keeping both cached means the list,
// filters, and Xero-total code never have to recompute from children.
model InvoiceLineItem {
  id              String   @id @default(cuid())
  invoiceId       String
  description     String
  quantity        Int      @default(1)
  unitAmountCents Int
  // Cached line total = quantity * unitAmountCents.
  amountCents     Int
  // Optional per-line Xero revenue account. At sync time it falls back to the
  // invoice's source (package/product) account, then the connection default.
  xeroAccountCode String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

// ─── Training Library ─────────────────────────────────────────────────────────

model LibraryType {
  id        String   @id @default(cuid())
  trainerId String
  isSample  Boolean  @default(false)
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  themes  LibraryTheme[]

  @@index([trainerId])
  @@map("library_types")
}

model LibraryTheme {
  id        String   @id @default(cuid())
  typeId    String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  type  LibraryType   @relation(fields: [typeId], references: [id], onDelete: Cascade)
  tasks LibraryTask[]

  @@index([typeId])
  @@map("library_themes")
}

model LibraryTask {
  id          String   @id @default(cuid())
  themeId     String
  title       String
  description String?  @db.Text // Tiptap rich text — render with <RichText />
  repetitions Int?
  /// FIRST video only, kept in step with `videos[0]`.
  ///
  /// Every older reader — the client app, templates, default homework, the
  /// session screen — still selects this column, so it is written on every save
  /// rather than dropped. Retire it once nothing reads it; see instructional-videos.ts.
  videoUrl    String?
  /// Just the video rows of `media`, kept in step with it. See below.
  videos      Json     @default("[]")
  /// EVERYTHING attached to this item, in the order a client meets it:
  /// `[{ kind, url, title?, fileName? }]` where kind is image | video |
  /// document | link.
  ///
  /// One list, because a picture, a handout and a clip are the same job — the
  /// stuff a client looks at while they do the exercise — and three separate
  /// columns made a second handout impossible to attach and gave the trainer no
  /// say in what a client meets first.
  ///
  /// Json rather than a child table because nothing ever asks a question OF a
  /// row: every read fetches the item and renders the lot, every write replaces
  /// the lot. And homework is a SNAPSHOT of this item, so the list has to copy
  /// across at hand-out time — one assignment here, N inserts if it were rows.
  ///
  /// The columns below are DERIVED from it by lib/library-media.ts
  /// (`mediaColumns`) and written on every save: `videos`/`videoUrl` are the
  /// video rows, `imageUrl` is the FIRST image, `fileUrl`/`fileName` the FIRST
  /// document. They stay because the default-homework builder, the offering
  /// suggestion list and the demo seed all still select them — a column dropped
  /// from under a reader is a blank on a client's screen. Nothing writes them
  /// directly any more.
  media       Json     @default("[]")
  imageUrl    String?
  fileUrl     String?
  fileName    String? // original filename, for the download link's label
  /// Does the client log a session against this, or just read it?
  ///
  /// The library isn't only a homework source — plenty of it is reference a client
  /// looks at ("how to fit a harness"), where asking them to record reps and rate
  /// how it went is noise. True = the training log appears; false = it's reading
  /// material. (Karl, 2026-07-30.)
  wantsLog    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  theme           LibraryTheme         @relation(fields: [themeId], references: [id], onDelete: Cascade)
  // Homework rows created FROM this library item — the "who currently has this"
  // list on the item page. Snapshots keep their own copy of the text, so the
  // link is nullable and deleting the library item leaves the homework intact.
  assignments     TrainingTask[]
  // Offerings that suggest this item by default. Unlike `assignments` these are
  // NOT snapshots — they read through to this row — so deleting the item takes
  // the default with it.
  packageDefaults PackageDefaultTask[]

  @@index([themeId])
  @@map("library_tasks")
}

// Default homework a trainer configures ONCE on an offering — "everyone who
// books the puppy consult gets these three things after session 1".
//
// Nothing is ever assigned automatically. The rows are SUGGESTED on the session
// screen and the trainer confirms the lot in one tap, instead of hunting the
// same five library items out every time. On confirm they become ordinary
// TrainingTasks — snapshots, editable and deletable per client, with no link
// back to here.
//
// Lives on Package because Package is the template for BOTH a 1:1 consult
// (isGroup=false) and a group class (isGroup=true), so one editor covers both.
model PackageDefaultTask {
  id            String         @id @default(cuid())
  packageId     String
  // 1-based session number within the offering ("session 3 of 6").
  // null = suggest after EVERY session.
  sessionIndex  Int?
  // Whether this one is preparation for the session or practice after it.
  // Copied onto the TrainingTask at hand-out time — see HomeworkTiming.
  timing        HomeworkTiming @default(AFTER_SESSION)
  // When set, the text is read LIVE from the library item at suggest time, so
  // editing the library keeps every offering's defaults current. The snapshot
  // is taken at confirm, exactly like any other library assignment.
  libraryTaskId String?
  // Inline one-off default, for something that isn't worth a library item.
  // Ignored when libraryTaskId is set.
  title         String?
  description   String?        @db.Text
  repetitions   Int?
  videoUrl      String?
  order         Int            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  package     Package      @relation(fields: [packageId], references: [id], onDelete: Cascade)
  libraryTask LibraryTask? @relation(fields: [libraryTaskId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([libraryTaskId])
  @@map("package_default_tasks")
}

// One step of a SERIES curriculum — "session 2 is loose-lead walking".
//
// Lives on the Package because the curriculum is the TEMPLATE: every client who
// buys the series gets the same plan. What varies per client is which session
// covered which step, and that is stamped on the session
// (TrainingSession.sessionPlanId) rather than counted, because the trainer may
// skip a step for a dog that already has it.
//
// Homework is deliberately NOT duplicated here. PackageDefaultTask already keys
// per-session homework off the same 1-based sessionIndex, so a step and its
// homework are joined on that number — one editor, one place to change it, and
// no way for the two to disagree about what "session 3" means.
model PackageSessionPlan {
  id           String  @id @default(cuid())
  packageId    String
  /// 1-based step number within the series ("session 3 of 6"). The same
  /// numbering PackageDefaultTask.sessionIndex uses, deliberately.
  sessionIndex Int
  title        String
  /// PUBLIC. What this session covers, written for the CLIENT to read — it
  /// shows on their session in the client app. Rich text (the same constrained
  /// HTML every other description in the app stores), so it must be rendered
  /// through RichText, never printed raw.
  description  String? @db.Text
  /// PRIVATE. The trainer's own jottings about this step. NEVER leaves the
  /// trainer side: it must not be selected by anything feeding the (client)
  /// route group or a client-facing API. Deliberately absent from the shared
  /// `CurriculumStep` type in lib/series.ts, so it can only be read by asking
  /// for it by name — a `select: *` is how a note like this leaks.
  privateNote  String? @db.Text
  order        Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  package  Package           @relation(fields: [packageId], references: [id], onDelete: Cascade)
  // Sessions that cover this step. SetNull on the session side, so retiring a
  // step never deletes bookings already in the diary.
  sessions TrainingSession[]

  @@unique([packageId, sessionIndex])
  @@index([packageId])
  @@map("package_session_plans")
}

// ─── Client Notifications ─────────────────────────────────────────────────────

model ClientNotification {
  id        String   @id @default(cuid())
  clientId  String
  trainerId String
  subject   String
  notes     String?  @db.Text
  sentAt    DateTime @default(now())

  client  ClientProfile  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_notifications")
}

// ─── Trainer Availability ─────────────────────────────────────────────────────

model AvailabilitySlot {
  id           String    @id @default(cuid())
  trainerId    String
  isSample     Boolean   @default(false)
  title        String?
  dayOfWeek    Int? // 1=Mon … 7=Sun; null = one-off date
  date         DateTime? @db.Date
  startTime    String // "HH:MM" 24-hr
  endTime      String // "HH:MM" 24-hr
  // 1 = weekly, 2 = fortnightly, etc. Only used when dayOfWeek is set.
  cadenceWeeks Int       @default(1)
  // Anchor date for cadence > 1 — defines parity (e.g. which fortnight is "on").
  firstDate    DateTime? @db.Date
  createdAt    DateTime  @default(now())

  // Mirrored Google Calendar event id (when the trainer has Google Calendar
  // sync on). Null = not yet mirrored / not connected.
  googleEventId String?

  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId])
  @@map("availability_slots")
}

// Trainer holiday / blackout periods. Days that fall inside one of these
// ranges count as unavailable, regardless of weekly slots.
model BlackoutPeriod {
  id        String   @id @default(cuid())
  trainerId String
  reason    String?
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now())

  // Mirrored Google Calendar (all-day) event id when the trainer has sync on.
  googleEventId String?

  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId])
  @@map("blackout_periods")
}

// Calendly-style public booking page. One config row per trainer, exposed at
// /c/<slug>/book. Discrete bookable time-slots are derived at request time
// from the trainer's AvailabilitySlots minus blackouts and existing sessions,
// sliced by slotLengthMins/slotIntervalMins. A pick by an existing client runs
// the self-book engine (instant or BookingRequest per requiresApproval); a pick
// by a public prospect creates an Enquiry the trainer accepts (the accept both
// converts them to a client and books the chosen slot). Optionally tied to a
// package, in which case the chosen slot is session 1 and the rest auto-place
// on the package cadence; with no package each pick books a single session.
model BookingPage {
  id               String      @id @default(cuid())
  trainerId        String
  // URL segment under /c/<trainerSlug>/book/<slug>. Unique per trainer. A
  // trainer can run several pages (e.g. "intro-call", "puppy-class") each with
  // their own package, slot rules and approval setting.
  slug             String
  // Internal label (also the default public headline if none set).
  name             String      @default("Book a session")
  order            Int         @default(0)
  enabled          Boolean     @default(false)
  headline         String?
  intro            String?     @db.Text
  // Trainer-set slot granularity. slotLengthMins is the session length each
  // slot represents; slotIntervalMins is the step between consecutive slot
  // starts (e.g. 60-min slots every 30 min produces overlapping start times).
  slotLengthMins   Int         @default(60)
  slotIntervalMins Int         @default(60)
  // Per-link instant-vs-approval choice for booking by an existing client.
  // (Prospects always route through Enquiry accept, which is itself approval.)
  requiresApproval Boolean     @default(true)
  // Pay-to-confirm: when true an existing client must pay before the slot is
  // booked (the connect webhook materialises it on success). Payment supersedes
  // requiresApproval. The price is the package's (when packageId is set) or
  // priceCents for a single-session page. Prospects still route via Enquiry.
  requiresPayment  Boolean     @default(false)
  // Single-session price (minor units) when the page has no package. Ignored
  // for package pages — those charge the package's own price.
  priceCents       Int?
  // Earliest a slot may be booked, in hours from now — stops same-minute books.
  minNoticeHours   Int         @default(12)
  // How far ahead slots are offered.
  windowDays       Int         @default(28)
  // Per-page availability window. When availStartTime + availEndTime are both
  // set, the page generates slots directly from these (availDays + the daily
  // window) instead of the trainer's global schedule availability. Times are
  // "HH:MM" 24h; availDays is ISO weekdays (1=Mon..7=Sun).
  availDays        Json        @default("[1,2,3,4,5]")
  availStartTime   String?
  availEndTime     String?
  // Optional package the booking kicks off. Null = single one-off session of
  // slotLengthMins. SetNull so deleting the package just reverts to single.
  packageId        String?
  sessionType      SessionType @default(IN_PERSON)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainer     TrainerProfile      @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  package     Package?            @relation(fields: [packageId], references: [id], onDelete: SetNull)
  automations BookingAutomation[]
  sessions    TrainingSession[]

  @@unique([trainerId, slug])
  @@index([trainerId])
  @@index([packageId])
  @@map("booking_pages")
}

// When an automation fires relative to a booking.
enum BookingAutomationTrigger {
  ON_BOOKING // immediately when the slot is booked / requested
  BEFORE_SESSION // offsetMinutes before the session start
  AFTER_SESSION // offsetMinutes after the session start
}

// A trainer-authored email that fires automatically off a booking-page booking.
// ON_BOOKING sends inline at booking time; BEFORE/AFTER_SESSION are picked up by
// the booking-automations cron once their offset relative to the session is due.
// Subject/body are plain text with {name} {dog} {time} {business} placeholders.
model BookingAutomation {
  id            String                   @id @default(cuid())
  bookingPageId String
  trigger       BookingAutomationTrigger
  // Minutes relative to the session start for BEFORE/AFTER. Ignored for ON_BOOKING.
  offsetMinutes Int                      @default(1440)
  enabled       Boolean                  @default(true)
  subject       String
  body          String                   @db.Text
  order         Int                      @default(0)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  bookingPage BookingPage             @relation(fields: [bookingPageId], references: [id], onDelete: Cascade)
  sends       BookingAutomationSend[]

  @@index([bookingPageId])
  @@map("booking_automations")
}

// One row per (automation, session) already sent — dedups the time-based cron
// so a reminder/follow-up goes out exactly once even if ticks overlap.
model BookingAutomationSend {
  id           String   @id @default(cuid())
  automationId String
  sessionId    String
  sentAt       DateTime @default(now())

  automation BookingAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  session    TrainingSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([automationId, sessionId])
  @@index([sessionId])
  @@map("booking_automation_sends")
}

// ─── Automated communication flows (per class / drop-in / event) ─────────────
// A trainer builds a flow of timed messages relative to each session of a
// ClassRun — "3 days before → push", "15 min before → push", "2 hours after →
// in-app". Every group offering (class, drop-in, event) materialises as a
// ClassRun with TrainingSessions, so the flow attaches to the run. The
// comms-flows cron scans sessions and sends each due step once per recipient.

enum CommsFlowDirection {
  BEFORE_SESSION // offsetMinutes before session start
  AFTER_SESSION // offsetMinutes after session start
  // Membership steps have no sessions to hang off, so they anchor on the
  // purchase instead: offsetMinutes after they bought it (welcome, day-7
  // check-in), or before the current period ends (renewal, expiry).
  AFTER_PURCHASE
  BEFORE_PERIOD_END
}

// Who a step reaches within the run's enrolments.
enum CommsFlowAudience {
  ENROLLED // ENROLLED enrolments only (default)
  ENROLLED_AND_WAITLIST // also WAITLISTED
  CUSTOM // only the clients in customClientIds
  // The trainer's own team, not clients — "you're teaching Puppy Class in an
  // hour", "a new member joined". Recipients are the people working THAT
  // session: its assignedTrainer, else the ClassRun's assigned members, else
  // the business owner. Never the whole company — a reminder about one class
  // has no business on the phone of someone who isn't on it.
  // Staff-only steps are the ONLY ones allowed the IN_APP channel:
  // the trainer bell reads Notification, the client feed shouldn't fill with
  // duplicated reminder rows.
  STAFF
}

// One timed message in a class/drop-in/event's flow. channels reuses the
// notification channel enum (push / email / in-app). title/body are plain text
// with {{name}} {{dog}} {{time}} {{date}} {{class}} {{business}} {{location}}.
model CommsFlowStep {
  id              String                @id @default(cuid())
  // A step attaches to exactly ONE offering: a ClassRun (group class / drop-in /
  // event / puppy school — recipients are its enrolments) OR a Package (a 1:1
  // package — recipients are the client on each generated session). The API
  // enforces that exactly one is set.
  classRunId      String?
  packageId       String?
  // A Membership — recipients are the clients holding an active purchase of it.
  membershipId    String?
  direction       CommsFlowDirection    @default(BEFORE_SESSION)
  offsetMinutes   Int                   @default(1440)
  channels        NotificationChannel[]
  audience        CommsFlowAudience     @default(ENROLLED)
  // Client ids (ClientProfile.id) this step targets when audience = CUSTOM.
  customClientIds String[]              @default([])
  // Overrides a client's channel opt-out so the message always delivers
  // (cancellations, venue changes). Off by default — routine reminders respect
  // the client's mute (User.notifyPush / User.productEmailOptOut).
  important       Boolean               @default(false)
  title           String
  body            String                @db.Text
  // Optional rich (HTML) body used only for the EMAIL channel — authored with
  // the same editor as email templates. Push/in-app keep the plain `body`.
  // Null = fall back to `body` for email too.
  emailBody       String?               @db.Text
  enabled         Boolean               @default(true)
  order           Int                   @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  classRun   ClassRun?       @relation(fields: [classRunId], references: [id], onDelete: Cascade)
  package    Package?        @relation(fields: [packageId], references: [id], onDelete: Cascade)
  membership Membership?     @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  sends      CommsFlowSend[]

  @@index([classRunId])
  @@index([packageId])
  @@index([membershipId])
  @@map("comms_flow_steps")
}

// One row per (step, session, recipient) already sent — dedups the */5 cron so
// each message reaches each client exactly once even if ticks overlap.
model CommsFlowSend {
  id         String   @id @default(cuid())
  stepId     String
  // Exactly one anchor: the session a class/package step fired for, or the
  // membership purchase a membership step fired for.
  sessionId  String?
  purchaseId String?
  userId     String // the recipient's User.id
  sentAt     DateTime @default(now())

  step     CommsFlowStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  session  TrainingSession?    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  purchase MembershipPurchase? @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@unique([stepId, sessionId, userId])
  @@unique([stepId, purchaseId, userId])
  @@index([sessionId])
  @@index([purchaseId])
  @@map("comms_flow_sends")
}

// A trainer-owned, reusable flow saved as a template so it can be dropped onto
// another offering of the same type in one click. `steps` is a JSON array of
// { direction, offsetMinutes, channels, audience, important, title, body }.
model CommsFlowTemplate {
  id        String   @id @default(cuid())
  trainerId String
  name      String
  steps     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId])
  @@map("comms_flow_templates")
}

// ─── System-wide discounts ───────────────────────────────────────────────────
// A trainer-authored, condition-based discount evaluated by src/lib/discounts.
// Attaches to one Package (any offering — class/drop-in/event/puppy-school/1:1)
// via packageId, or is trainer-wide (packageId null) and available to any
// offering. modifierValue is cents for FLAT/REPLACE, a percent for PERCENT.

enum DiscountModifierType {
  PERCENT // % off
  FLAT // fixed amount off (cents)
  REPLACE // set the price to this amount (cents)
}

model Discount {
  id            String               @id @default(cuid())
  trainerId     String
  // Which offering this attaches to. Null = a trainer-wide discount usable by
  // any offering (the evaluator is offering-agnostic).
  packageId     String?
  name          String
  // Client-facing label ("Whole-day rate"); falls back to name.
  formText      String?
  modifierType  DiscountModifierType
  modifierValue Int
  // per_item | per_person | cheapest_item | most_expensive_item | order_total.
  applyTo       String               @default("order_total")
  // DiscountCondition[] JSON — see src/lib/discounts/evaluate.ts.
  conditions    Json                 @default("[]")
  isActive      Boolean              @default(true)
  validFrom     DateTime?
  expiresAt     DateTime?
  // Optional usage cap (atomic claim on redemption, like FM's booking-discount-claim).
  maxUses       Int?
  usesCount     Int                  @default(0)
  order         Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  package Package?       @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([trainerId])
  @@index([packageId])
  @@map("discounts")
}

// ─── Combo memberships ───────────────────────────────────────────────────────
// A trainer bundles several offerings (1:1 packages, a class place, products)
// into one purchasable membership, sold at a bundle price. On payment the
// connect webhook grants every included item. Phase 1 is ONE_OFF; RECURRING
// (with minTermCount + earlyTermFeeCents) rides on the off-session mandate
// layer, shared with puppy-school recurring billing.

enum MembershipCadence {
  ONE_OFF
  RECURRING
}

// WHO a package is for, as distinct from whether it can be paid for.
//
// The motivating case is a ladder: a junior client should not be able to buy
// their way into a senior package. So the gate is a PREREQUISITE, checked at the
// moment of joining and never afterwards — raising the bar later must not evict
// people who are already paying, and an achievement is permanent so a
// prerequisite can never lapse mid-subscription.
enum MembershipEligibility {
  PUBLIC // anyone who can see the trainer's packages
  ACHIEVEMENT // must hold EVERY achievement in prerequisites
  INVITE_ONLY // only people the trainer has individually invited
}

enum MembershipInterval {
  WEEK
  FORTNIGHT
  MONTH
}

// What an included line points at. Puppy-school inclusion is just a CLASS item
// pointing at the puppy school's run.
enum MembershipItemKind {
  PACKAGE // a 1:1 package → assigned as a ClientPackage (×quantity)
  CLASS // a class run → enrol the buyer (or a request, if the class needs approval)
  PRODUCT // a shop product → a product order (×quantity)
}

enum MembershipPurchaseStatus {
  ACTIVE
  CANCELLED
  LAPSED
  // ─── Recurring only ────────────────────────────────────────────────────────
  // A payment failed and Stripe is still retrying. Access CONTINUES through the
  // retry window — we do not cut a client off from their dog's classes because
  // a card bounced on a Tuesday. Only Stripe giving up moves them out of here.
  // A payment failed. Access is PAUSED from that first failure (Karl,
  // 2026-07-27) — not after Stripe exhausts its retries. Stripe keeps retrying
  // underneath, and a retry that succeeds restores everything.
  PAST_DUE
  // They cancelled but have paid through to currentPeriodEnd. "I cancelled and
  // I still get my sessions until the 14th" and "I'm cut off" are different
  // states and the client screen must say different words for them — that is
  // the whole reason this is separate from CANCELLED.
  CANCELLING
  PAUSED
  // The trainer disconnected their Stripe account or left PupManager, so there
  // is no longer anyone to bill on behalf of. Distinct from CANCELLED because
  // the CLIENT did not choose this and the wording they see must not imply they
  // did — and because we need to be able to find these rows later.
  ORPHANED
}

// A Stripe invoice's lifecycle, mirrored per billing cycle. Deliberately the
// same vocabulary Stripe uses so a support conversation can quote either side.
enum MembershipInvoiceStatus {
  DRAFT
  OPEN
  PAID
  UNCOLLECTIBLE
  VOID
}

// Why a client had to ask instead of just buying. Kept on the row so the
// trainer's notification (and, later, their inbox) can tell the two jobs apart:
// a recurring plan needs setting up, an unpriced one needs a price first.
enum MembershipRequestReason {
  RECURRING // ongoing plan — no mandate layer yet, so checkout can't take it
  NO_PRICE // published without a price
  // The one that runs the other way: the TRAINER asked the client, not the
  // client asking the trainer. PENDING means invited and not yet taken up;
  // FULFILLED means they joined; DECLINED is the invitation being withdrawn,
  // which is also how an invite is revoked.
  INVITE
}

enum MembershipRequestStatus {
  PENDING // client wants this, trainer hasn't actioned it
  FULFILLED // trainer accepted — the client is on the package (payment arranged separately)
  DECLINED // trainer said no / handled it another way. Keeps the list from growing forever.
  // Trainer asked the client to subscribe and pay for it themselves, rather
  // than granting it for free. A distinct state because "I gave it to them" and
  // "I've asked them to pay and I'm waiting" are different things for a trainer
  // to look at — collapsing them into FULFILLED would tell them a plan was
  // running when nobody has paid for anything yet.
  INVITED
}

// A client asking for a membership they can't check out themselves. Mirrors
// ProductRequest (the shop's "request this" path) deliberately: same PENDING
// row, same idempotency, same CLIENT_SHOP_ORDER notification — so the client
// meets one behaviour wherever something can't be bought outright.
// An achievement a client must already hold to join a package.
//
// ALL of them are required, never any-of. A ladder is a sequence of things you
// have done, and "any one of these" would let someone skip a rung. If a trainer
// genuinely wants alternatives they can award one achievement by two routes,
// which keeps the meaning in the achievement rather than hidden in this table.
model MembershipPrerequisite {
  id            String   @id @default(cuid())
  membershipId  String
  achievementId String
  createdAt     DateTime @default(now())

  membership  Membership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([membershipId, achievementId])
  @@index([achievementId])
  @@map("membership_prerequisites")
}

model MembershipRequest {
  id           String                  @id @default(cuid())
  clientId     String
  membershipId String
  reason       MembershipRequestReason
  status       MembershipRequestStatus @default(PENDING)

  fulfilledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  client     ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  membership Membership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([clientId, status])
  @@index([membershipId, status])
  @@map("membership_requests")
}

model Membership {
  id                String              @id @default(cuid())
  trainerId         String
  name              String
  description       String?             @db.Text
  imageUrl          String?
  // Storefront card styling (hex strings). Null = the app's default theme.
  // featuredColor tints the price + the "Get this membership" button.
  bgColor           String?
  headerColor       String?
  textColor         String?
  featuredColor     String?
  // Custom label for the storefront buy button. Null = "Get this membership".
  buttonText        String?
  // Buy-button colours. Null = fall back to featuredColor / an auto-picked
  // legible label. Whatever is stored here is still put through the 4.5:1
  // contrast guard in lib/membership-card-colors.ts before it is painted.
  buttonBgColor     String?
  buttonTextColor   String?
  priceCents        Int
  cadence           MembershipCadence   @default(ONE_OFF)
  interval          MembershipInterval? // for RECURRING
  // Recurring minimum commitment in cycles (0 = cancel any time) + an optional
  // early-termination fee if they leave within it.
  minTermCount      Int                 @default(0)
  earlyTermFeeCents Int?
  published         Boolean             @default(false)

  // Eligibility is deliberately separate from `published`. Published means the
  // package exists and is finished; eligibility means this particular client is
  // allowed to join it. A locked package is still published — that is the whole
  // point of showing someone the rung above them on the ladder.
  eligibility    MembershipEligibility @default(PUBLIC)
  // Show a package the client can't join yet, greyed out with what they'd need,
  // or hide it entirely. Per package, because "work towards this" and "this is
  // none of your business" are both legitimate.
  showWhenLocked Boolean               @default(true)

  // Public URL slug for the booking-page storefront (unique per trainer).
  slug      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainer        TrainerProfile           @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  items          MembershipItem[]
  purchases      MembershipPurchase[]
  requests       MembershipRequest[]
  commsFlowSteps CommsFlowStep[]
  plans          MembershipPlan[]
  consents       MembershipConsent[]
  prerequisites  MembershipPrerequisite[]

  @@unique([trainerId, slug])
  @@index([trainerId])
  @@map("memberships")
}

// A RECURRING membership can offer several billing options (e.g. $10/week OR
// $35/month), each with its own price, minimum term and cancellation fee — the
// client picks one at checkout. ONE_OFF memberships don't use these (they carry
// a single Membership.priceCents). Not purchasable until recurring billing
// (mandates) ships, but configured + shown on the storefront now.
model MembershipPlan {
  id                String             @id @default(cuid())
  membershipId      String
  interval          MembershipInterval // WEEK | FORTNIGHT | MONTH
  priceCents        Int
  minTermCount      Int                @default(0) // cycles; 0 = cancel any time
  earlyTermFeeCents Int?
  order             Int                @default(0)

  // Cached Stripe Product/Price ids for THIS plan, on the TRAINER'S connected
  // account. Split live/test exactly like BillingItem does, because a sandbox
  // trainer's ids mean nothing in live mode and vice versa.
  //
  // Minted lazily on first sale. Stripe Prices are IMMUTABLE, so a trainer
  // editing priceCents/interval must NULL these out (see the plan-editor write
  // path) — the next sale then mints a fresh Price and existing subscribers keep
  // the one they agreed to. That is what stops a price edit silently re-pricing
  // everybody who already subscribed.
  stripeProductId     String?
  stripeProductIdTest String?
  stripePriceId       String?
  stripePriceIdTest   String?

  // Set when the trainer edits a membership whose plans already have live
  // subscribers. The plan stops being offered to NEW clients, but the row (and
  // its immutable Stripe Price) survives so everyone already subscribed keeps
  // billing on exactly what they agreed to. Deleting it instead would strip
  // MembershipPurchase.planId off live subscriptions and lose the price, term
  // and interval they signed up for.
  archivedAt DateTime?

  membership Membership           @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  purchases  MembershipPurchase[]

  @@index([membershipId])
  @@map("membership_plans")
}

// One included offering. The offering ids are plain references (no FK) so a
// membership survives an offering being reshuffled; fulfilment resolves + skips
// anything that has since vanished.
model MembershipItem {
  id               String             @id @default(cuid())
  membershipId     String
  kind             MembershipItemKind
  packageId        String? // PACKAGE
  classRunId       String? // CLASS
  productId        String? // PRODUCT
  quantity         Int                @default(1)
  // Recurring only: re-grant this item each renewal (products) vs one-time.
  regrantOnRenewal Boolean            @default(false)
  order            Int                @default(0)
  // Optional per-item presentation overrides for the storefront. Null = fall
  // back to the linked offering's own image/description (products & class runs
  // carry an imageUrl; all three carry a description). Lets a trainer give a
  // bundled item its own picture/blurb without changing the offering itself.
  imageUrl         String?
  description      String?            @db.Text

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId])
  @@map("membership_items")
}

model MembershipPurchase {
  id               String                   @id @default(cuid())
  membershipId     String
  trainerId        String
  clientId         String
  status           MembershipPurchaseStatus @default(ACTIVE)
  purchasedAt      DateTime                 @default(now())
  currentPeriodEnd DateTime? // RECURRING
  committedUntil   DateTime? // end of the minimum term
  // The settled Payment that bought it.
  paymentId        String?
  sandbox          Boolean                  @default(false)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  // ─── RECURRING (Phase 1) ───────────────────────────────────────────────────
  // Which billing option they chose ($10/wk vs $35/mo). Null for a ONE_OFF.
  planId                String?
  // The Stripe Subscription on the TRAINER'S connected account. Unique so a
  // replayed webhook or a double-tapped Subscribe can never produce two rows for
  // one subscription — the DB refuses it even if a guard upstream is buggy.
  stripeSubscriptionId  String?   @unique
  // The Customer on the trainer's account. One per (client, trainer) pair — a
  // client training with two businesses has two unrelated Customers, mirroring
  // ClientProfile's own (userId, trainerId) composite identity.
  stripeCustomerId      String?
  currentPeriodStart    DateTime?
  cancelAtPeriodEnd     Boolean   @default(false)
  cancelledAt           DateTime?
  cancelReason          String?
  lastPaymentFailedAt   DateTime?
  failedPaymentCount    Int       @default(0)
  // The application_fee_percent we ACTUALLY set on the subscription, recorded so
  // a later margin change is a visible, deliberate migration of existing
  // subscriptions rather than invisible drift between the row and Stripe.
  applicationFeePercent Decimal?  @db.Decimal(5, 2)

  // A snapshot of the card on file, so the client can be told exactly WHICH
  // card needs attention ("your card ending 4242 expires before your next
  // payment"). Refreshed whenever we look at the subscription. Never the full
  // number — Stripe holds that; these four are all Stripe itself exposes.
  cardBrand        String?
  cardLast4        String?
  cardExpMonth     Int?
  cardExpYear      Int?
  // When access was paused for non-payment, and when it came back. Kept as
  // timestamps rather than a bare flag so "how long were they locked out" is
  // answerable after the fact.
  accessPausedAt   DateTime?
  accessRestoredAt DateTime?
  // When a failed payment stops actually costing them access. Set on the FIRST
  // failure of a dunning episode and left alone by later retries, so the window
  // is two weeks from the first miss rather than two weeks from the latest one.
  // Cleared the moment a payment succeeds.
  accessGraceUntil DateTime?

  membership     Membership          @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  plan           MembershipPlan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  commsFlowSends CommsFlowSend[]
  invoices       MembershipInvoice[]

  @@index([membershipId])
  @@index([trainerId])
  @@index([clientId])
  @@index([planId])
  @@index([status])
  @@map("membership_purchases")
}

// The client's recorded, explicit permission for a trainer to charge their card
// while nobody is watching. Written BEFORE the Stripe redirect — the same
// "record it first, reconcile after" shape as the PENDING Payment — so a consent
// always exists for any subscription that can possibly come into being.
//
// consentText is stored VERBATIM on purpose. In a dispute six months later,
// "our template at the time said X" is a far weaker answer than "here is exactly
// what they were shown, here is the tick, here is the timestamp".
model MembershipConsent {
  id           String             @id @default(cuid())
  clientId     String
  membershipId String
  planId       String?
  // What was on screen when they ticked the box. Snapshotted rather than joined,
  // because the plan can be edited afterwards and the agreement cannot.
  priceCents   Int
  currency     String
  interval     MembershipInterval

  consentText          String  @db.Text
  consentVersion       String
  // Stripe's own record of the mandate, written back once the subscription
  // exists. Null until then (and for a consent whose checkout was abandoned).
  stripeMandateId      String?
  stripeSubscriptionId String?

  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  client     ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  membership Membership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([membershipId])
  @@index([stripeSubscriptionId])
  @@map("membership_consents")
}

// One row per billing cycle, mirrored from the Stripe Invoice.
//
// Exists so the client can see "here is what you have been charged", the trainer
// can refund a single cycle, and Xero has something per-cycle to reconcile.
// stripeInvoiceId is @unique — that natural key is idempotency layer 2 for the
// invoice.* handlers (layer 1 is the StripeWebhookEvent ledger, layer 3 is the
// re-check inside the transaction).
model MembershipInvoice {
  id                   String @id @default(cuid())
  membershipPurchaseId String
  stripeInvoiceId      String @unique

  periodStart DateTime?
  periodEnd   DateTime?
  amountDue   Int
  amountPaid  Int                     @default(0)
  currency    String
  status      MembershipInvoiceStatus @default(OPEN)

  // Stripe's hosted page for this invoice — where a client goes to approve or
  // retry a payment themselves.
  hostedInvoiceUrl String?
  // Set when the client's BANK demanded authentication on a renewal (3DS/SCA on
  // an off-session charge). Nothing in the app can act for them: the payment
  // simply does not happen until they tap through to Stripe's hosted page. That
  // is why this is a first-class field and not just another failure.
  actionRequiredAt DateTime?
  attemptCount     Int       @default(0)
  // The Payment row this cycle produced, so the EXISTING refund route, dispute
  // handler and Xero sync keep working unchanged on a recurring charge.
  paymentId        String?

  sandbox   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchase MembershipPurchase @relation(fields: [membershipPurchaseId], references: [id], onDelete: Cascade)

  @@index([membershipPurchaseId])
  @@index([paymentId])
  @@map("membership_invoices")
}

// Idempotency ledger for EVERY Stripe webhook event we process, keyed on
// Stripe's own event id.
//
// The existing PENDING→PAID transition stops double-FULFILMENT, but it does not
// stop a re-delivered invoice.paid from creating a second Payment row — the
// recurring flow is exposed to that because Stripe now sends events forever, not
// once per checkout. Insert-or-skip at the top of the handler is the only thing
// that reliably stops replays, and it protects the existing one-off flow too.
model StripeWebhookEvent {
  id          String   @id // Stripe's event id, evt_…
  type        String
  accountId   String? // the connected account (event.account), null on platform events
  sandbox     Boolean  @default(false)
  processedAt DateTime @default(now())

  @@index([type])
  @@index([accountId])
  @@map("stripe_webhook_events")
}

// ─── Trainer-defined Achievements ────────────────────────────────────────────

enum AchievementTrigger {
  MANUAL
  FIRST_SESSION
  SESSIONS_COMPLETED
  IN_PERSON_SESSIONS
  VIRTUAL_SESSIONS
  CONSECUTIVE_SESSIONS_ATTENDED
  FIRST_PACKAGE_ASSIGNED
  PACKAGES_COMPLETED
  FIRST_HOMEWORK_DONE
  HOMEWORK_TASKS_DONE
  HOMEWORK_STREAK_DAYS
  PERFECT_WEEK
  CLIENT_ANNIVERSARY_DAYS
  MESSAGES_SENT
  PRODUCTS_PURCHASED
  PROFILE_COMPLETED
}

// Trainer-curated catalogue of achievements / badges. Each row is *either* a
// MANUAL achievement (trainer awards from the client profile) *or* an automatic
// rule with a trigger type and threshold (system awards via evaluateAchievementsFor).
model Achievement {
  id           String             @id @default(cuid())
  trainerId    String
  isSample     Boolean            @default(false)
  name         String
  description  String?            @db.Text
  icon         String?
  color        String?
  // Optional badge artwork (Vercel Blob URL), uploaded by the trainer. When set
  // it replaces the emoji icon everywhere the badge is drawn; `icon` stays as
  // the fallback so removing the image restores the emoji.
  imageUrl     String?
  order        Int                @default(0)
  // When false the achievement is hidden from clients and not auto-awarded.
  // Trainers use this to draft new achievements before surfacing them or to
  // pause an existing one without deleting it.
  published    Boolean            @default(true)
  // Auto-award rule. MANUAL = no auto-award; the rest are evaluated by the
  // awarder helper when relevant counters change. triggerValue is the integer
  // threshold (eg 5 for "5 sessions"); null for binary triggers.
  triggerType  AchievementTrigger @default(MANUAL)
  triggerValue Int?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  trainer       TrainerProfile           @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  awards        ClientAchievement[]
  gatedPackages MembershipPrerequisite[]

  @@index([trainerId])
  @@map("achievements")
}

// Per-client award log. Unique on (clientId, achievementId) so the awarder is
// idempotent — re-evaluating a client never double-awards. earnedValue captures
// the snapshot counter at award time so the UI can render "5 sessions".
model ClientAchievement {
  id            String   @id @default(cuid())
  clientId      String
  achievementId String
  awardedAt     DateTime @default(now())
  // "system" for automatic awards, the trainer's userId for manual awards.
  awardedBy     String
  earnedValue   Int?

  client      ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  achievement Achievement   @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([clientId, achievementId])
  @@index([clientId])
  @@map("client_achievements")
}

// ─── Embed Forms ──────────────────────────────────────────────────────────────

model EmbedForm {
  id                     String  @id @default(cuid())
  trainerId              String
  isSample               Boolean @default(false)
  title                  String
  description            String? @db.Text
  // JSON array of { key: string, required: boolean } for standard fields
  // Keys: phone | dogName | dogBreed | dogWeight | dogDob | message
  fields                 Json    @default("[]")
  // JSON string[] of CustomField ids to include
  customFieldIds         Json    @default("[]")
  thankYouTitle          String? @db.Text
  thankYouMessage        String? @db.Text
  isActive               Boolean @default(true)
  // Styling — let trainers match the form to their site's brand.
  // showBorder draws the slate-200 card border around field groups;
  // off for embeds where the parent page already provides framing.
  // buttonColor is a hex string (e.g. "#2563eb") for the submit
  // button; null falls back to the platform blue.
  showBorder             Boolean @default(true)
  buttonColor            String?
  // Welcome email — sent by acceptEnquiry when a trainer accepts an
  // enquiry from this form and opts into the magic-link invite. All
  // null/default values fall back to the platform copy in
  // src/lib/enquiries.ts. Subject + intro support {business} and
  // {name} placeholders. welcomeShowDiaryButton hides the magic-link
  // CTA (and its label) for trainers who'd rather send a plain
  // welcome; the greeting, branding, and expiry note stay templated.
  welcomeSubject         String? @db.Text
  welcomeIntro           String? @db.Text
  welcomeShowDiaryButton Boolean @default(true)
  welcomeButtonLabel     String? @db.Text

  // Auto-reply — sent to the PERSON WHO FILLED IN THE FORM, immediately on
  // submit. Distinct from welcomeEmail above, which goes out later when the
  // trainer accepts the enquiry and opts into a magic link. Modes:
  //   OFF      — nothing sent (the default; preserves pre-existing behaviour)
  //   TEMPLATE — send the trainer's saved EmailTemplate (autoReplyTemplateId)
  //   CUSTOM   — send autoReplySubject / autoReplyBody, written on the form
  // Subject + body support the same {business} / {name} placeholders as the
  // welcome email. No login link is ever included: at submit time the enquiry
  // hasn't been accepted, so no client account exists to log in to.
  autoReplyMode       String  @default("OFF")
  autoReplyTemplateId String?
  autoReplySubject    String? @db.Text
  autoReplyBody       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainer           TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  enquiries         Enquiry[]
  // SetNull: deleting a template must not delete the form — it just falls
  // back to sending nothing until the trainer picks another.
  autoReplyTemplate EmailTemplate? @relation(fields: [autoReplyTemplateId], references: [id], onDelete: SetNull)

  @@index([trainerId])
  @@map("embed_forms")
}

// ─── Unified forms ────────────────────────────────────────────────────────────
// One authored form, built from the shared session-form-builder Question[]
// engine (7 field types + linked CustomFields + conditional `showIf` + optional
// multi-step pages). Unlike the field-library intake — which asks every field a
// trainer has ever defined, in one flat list — a Form is a real questionnaire:
// the trainer chooses the questions, their order, which page they sit on, and
// when they appear.
//
// A Form can be used two ways, and both at once:
//   usableAsIntake  — assigned to a client at invite time
//                     (ClientProfile.intakeFormId). The client is gated behind
//                     it until they complete it.
//   usableAsEnquiry — published publicly at /form/{id}. A submission creates an
//                     Enquiry, exactly like the legacy EmbedForm does.
//
// The legacy EmbedForm still backs the 49 lead-capture forms already live in
// production (and the public class-booking page, Instagram link-in-bio and the
// onboarding checklist all read it). It is deprecated as an authoring target —
// nothing creates a new one — and is scheduled to be folded into this model by
// an id-preserving data migration so live embed URLs keep resolving.
model Form {
  id          String  @id @default(cuid())
  trainerId   String
  isSample    Boolean @default(false)
  name        String
  // Optional rich-text intro shown above the questions on both the client
  // intake gate and the public enquiry form. Tiptap HTML — render through
  // <RichText>, never dangerouslySetInnerHTML (AGENTS.md).
  description String? @db.Text

  // What this form can be used for — a form can serve as both.
  usableAsIntake  Boolean @default(false)
  usableAsEnquiry Boolean @default(false)
  // Public URL slug for the enquiry use. Unique per trainer, and null for
  // intake-only forms. NOTE: the public URL keys on `id`, not `slug`, because
  // slug is only unique per-trainer and two trainers' identical slugs would
  // collide on a global public route. The slug is kept for a future
  // /c/{trainer}/{slug} vanity URL.
  slug            String?

  // Authored questions — the session-form-builder Question[] shape, each with
  // an optional `showIf` (conditional visibility) and `step` (which page).
  questions Json @default("[]")
  // Multi-step pages: [{ id, title }]. Empty = a single-page form.
  steps     Json @default("[]")

  // Success-page copy (enquiry use) + brand styling, mirroring EmbedForm.
  thankYouTitle   String? @db.Text
  thankYouMessage String? @db.Text
  showBorder      Boolean @default(true)
  buttonColor     String?

  // Per-form invite email copy, sent when a client is invited with this form as
  // their intake. Null falls back to the platform copy. Subject + body support
  // the same {business} / {name} placeholders as the welcome email.
  inviteSubject         String? @db.Text
  inviteBody            String? @db.Text
  inviteShowDiaryButton Boolean @default(true)
  inviteButtonLabel     String? @db.Text

  // ── One continuous run (enquiry → account → intake → their diary) ─────────
  //
  // Off, a public enquiry ends at a thank-you card and the person waits for the
  // trainer to accept them: "check your email, then start again". On, the
  // submission hands straight over to a password step and then to the intake
  // form, and they end up looking at their own diary without ever leaving the
  // run. Karl, 2026-08-02: "I want the enquiry form and the booking step to
  // feel like one continuous thing for the client."
  //
  // Turning it on IS the trainer's consent to admit whoever finishes: it is
  // their own form, on their own website, and only they can flip this. That is
  // why the run may create a ClientProfile where the /c/<slug>/join path
  // deliberately may not — there, nobody had said yes to anything.
  continueToAccount    Boolean @default(false)
  // The intake form asked once the account exists. Must be one of THIS
  // trainer's forms with usableAsIntake (checked server-side on save). Null =
  // no intake step; they land straight on their diary.
  continueIntakeFormId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Draft flag — a draft is hidden from the invite picker and 404s publicly.
  isActive Boolean @default(true)

  trainer            TrainerProfile  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  assignedClients    ClientProfile[] @relation("ClientIntakeForm")
  enquiries          Enquiry[]       @relation("EnquiryUnifiedForm")
  // Self-relation: the intake form this enquiry form hands over to. SetNull so
  // deleting the intake form turns the handover off rather than deleting the
  // enquiry form with it.
  continueIntakeForm Form?           @relation("FormContinuationIntake", fields: [continueIntakeFormId], references: [id], onDelete: SetNull)
  continuationOf     Form[]          @relation("FormContinuationIntake")

  @@unique([trainerId, slug])
  @@index([trainerId])
  @@map("forms")
}

// ─── Lead magnets (free download → mailing list) ──────────────────────────────
// A trainer-owned freebie: a downloadable file behind a branded public form.
// A prospect submits name + email (+ consent) and is emailed the download link
// and added to the trainer's mailing list (Subscriber). Gated by the
// 'leadmagnets' add-on. Public URL: /c/<trainerSlug>/free/<slug>.
model LeadMagnet {
  id              String   @id @default(cuid())
  trainerId       String
  slug            String // per-trainer unique, used in the public URL
  title           String
  description     String?  @db.Text
  // Landing-page copy (fall back to title/description when null).
  headline        String?  @db.Text
  intro           String?  @db.Text
  // Which landing-page layout the trainer picked: classic | split | minimal | none.
  layout          String   @default("classic")
  // Optional hero image (public Blob URL) shown on the photo-based layouts.
  imageUrl        String?
  // Per-magnet style overrides. accentColor (hex) overrides the trainer's brand
  // accent for the button/header; showHeader toggles the logo + business name;
  // showFieldLabels shows labels above the form fields (vs placeholders only).
  accentColor     String?
  showHeader      Boolean  @default(true)
  showTitle       Boolean  @default(true)
  showFieldLabels Boolean  @default(false)
  // The download itself — a public Vercel Blob URL (same model as digital
  // products). fileName/size are shown in the UI and the delivery email.
  fileUrl         String
  fileName        String
  fileSizeBytes   Int?
  // Consent copy shown beside the required checkbox. Platform-standard (not
  // trainer-editable); snapshotted onto each Subscriber for an audit trail.
  consentText     String   @default("I agree to receive emails and accept the privacy policy.") @db.Text
  // Trainer-customisable delivery email. Null falls back to the default copy
  // in lead-magnet-email.ts.
  emailSubject    String?  @db.Text
  emailIntro      String?  @db.Text
  thankYouTitle   String?  @db.Text
  thankYouMessage String?  @db.Text
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trainer     TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  subscribers Subscriber[]

  @@unique([trainerId, slug])
  @@index([trainerId])
  @@map("lead_magnets")
}

enum SubscriberStatus {
  SUBSCRIBED
  UNSUBSCRIBED
  BOUNCED
}

// A marketing subscriber on a trainer's single mailing list — an email-only
// lead captured via a lead magnet, decoupled from ClientProfile. The Marketing
// add-on can broadcast to SUBSCRIBED rows. sourceLeadMagnet is SetNull so
// deleting a magnet leaves its captured leads intact.
model Subscriber {
  id                 String           @id @default(cuid())
  trainerId          String
  email              String
  name               String?
  status             SubscriberStatus @default(SUBSCRIBED)
  sourceLeadMagnetId String?
  // Snapshot of the consent text + when they ticked it (compliance trail).
  consentText        String?          @db.Text
  consentAt          DateTime?
  unsubscribedAt     DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  trainer          TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  sourceLeadMagnet LeadMagnet?    @relation(fields: [sourceLeadMagnetId], references: [id], onDelete: SetNull)

  @@unique([trainerId, email])
  @@index([trainerId, status])
  @@map("subscribers")
}

// ─── Enquiries (lead funnel) ──────────────────────────────────────────────────
// Form submissions land here in NEW state. Trainer can Reply, then Accept
// (creates User + ClientProfile + Dog + magic-link email) or Decline.
// Form values are snapshotted as columns + JSON so an enquiry stays readable
// even if the embed form's field config changes later.

model Enquiry {
  id            String  @id @default(cuid())
  trainerId     String
  isSample      Boolean @default(false)
  formId        String? // null if the source form was deleted (legacy EmbedForm)
  // Set instead of formId when the enquiry came from a unified Form published
  // as an enquiry form. Both public form systems coexist while the legacy
  // EmbedForms are still live, so the provenance is kept separately rather than
  // overloading formId across two tables.
  unifiedFormId String?
  // Full question-id → answer snapshot for a unified-Form enquiry, for display
  // on the enquiry detail. acceptEnquiry maps `customFieldValues`, not this.
  // Null for EmbedForm enquiries.
  formAnswers   Json?

  // Snapshot of form values at submit time
  name              String
  email             String
  phone             String?
  dogName           String?
  dogBreed          String?
  dogWeight         Float?
  dogDob            DateTime?
  message           String?   @db.Text
  // { customFieldId: value } map of custom-field answers, snapshotted
  customFieldValues Json      @default("{}")

  // Where this enquiry came from. Drives the wording on the trainer's list
  // ("enquiry" vs "wants to join") and nothing else — the accept path is the
  // same for all of them, which is the point: one approval mechanism.
  //   FORM        — an embed / lead-capture form submission (the original, default)
  //   BOOKING     — the public Calendly-style booking page (bookedSlotAt set)
  //   SELF_SIGNUP — a dog owner who created their own PupManager login and
  //                 asked to be added to this trainer. The User row ALREADY
  //                 exists (with a password); accepting attaches the
  //                 ClientProfile via findOrJoinClient like any other accept.
  source String @default("FORM")

  status                EnquiryStatus @default(NEW)
  // Set when the trainer first opens the enquiry — drives the dashboard badge.
  viewedAt              DateTime?
  // Highest follow-up nudge already sent for this unanswered enquiry:
  // 0 = none, 1 = 6h, 2 = 18h, 3 = 24h, 4 = 36h. The enquiry-followups cron
  // bumps this as each threshold passes; reset is unnecessary because a reply
  // or status change takes the enquiry out of the cron's "unanswered" query.
  followupReminderLevel Int           @default(0)
  // Populated after Accept; gives a forward link to the resulting client.
  clientProfileId       String?       @unique

  // ── The continuous run's handover (Form.continueToAccount) ────────────────
  //
  // The enquiry row is written FIRST and the account second, on purpose: if the
  // person walks away at the password step the trainer still has a name, an
  // email and a phone number and can reply by hand. A run that stranded the
  // trainer would be worse than no run at all.
  //
  // What carries them from step to step is this token — sha256(plain +
  // AUTH_SECRET), the same shape as the accept-magic-link, so the plaintext
  // only ever exists in the person's URL bar and their inbox. It is what makes
  // the step SAFE: the account step takes its email address from THIS ROW, not
  // from anything posted to it, so there is no field an attacker can point at
  // somebody else's address.
  continuationTokenHash String?   @unique
  continuationExpiresAt DateTime?
  // Single use. Stamped when the account is created (or the already-registered
  // person signs in and is joined), so a link left in browser history or a
  // forwarded email cannot re-run the handover.
  continuationUsedAt    DateTime?

  // Set when the enquiry came from the public Calendly-style booking page:
  // the prospect's chosen slot (UTC instant) and the package they picked
  // (if the booking page offers one). On Accept these materialise into a
  // TrainingSession / package series so converting the prospect to a client
  // also books their session. bookedPackageId is a soft reference (no FK) —
  // it's re-validated against the trainer's packages at accept time.
  // bookedPageId points at the originating BookingPage (soft ref) so a
  // single-session booking can recover its duration / session type on accept.
  bookedSlotAt    DateTime?
  bookedPackageId String?
  bookedPageId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainer       TrainerProfile   @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  form          EmbedForm?       @relation(fields: [formId], references: [id], onDelete: SetNull)
  unifiedForm   Form?            @relation("EnquiryUnifiedForm", fields: [unifiedFormId], references: [id], onDelete: SetNull)
  clientProfile ClientProfile?   @relation(fields: [clientProfileId], references: [id], onDelete: SetNull)
  messages      EnquiryMessage[]

  @@index([trainerId, status])
  @@index([trainerId, createdAt])
  @@map("enquiries")
}

enum EnquiryStatus {
  NEW
  ACCEPTED
  DECLINED
  ARCHIVED
}

// Outbound replies the trainer sent to the enquirer. v1 is one-way (no
// inbound threading) so direction is implicit-outbound; we still keep the
// column to make v2 (Gmail/Microsoft OAuth, two-way) a non-breaking change.
model EnquiryMessage {
  id           String   @id @default(cuid())
  enquiryId    String
  direction    String   @default("OUTBOUND") // "OUTBOUND" | "INBOUND"
  subject      String
  bodyText     String   @db.Text
  // Rich-text (sanitized HTML) version of the body composed in the editor.
  // Null for legacy/plain or inbound messages; bodyText stays the plain fallback.
  bodyHtml     String?  @db.Text
  // Trainer (User) who composed and sent this. Null if system-generated.
  sentByUserId String?
  createdAt    DateTime @default(now())

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([enquiryId, createdAt])
  @@map("enquiry_messages")
}

// ─── Onboarding ──────────────────────────────────────────────────────────────

// Admin-editable wizard step content. The trainer-facing wizard reads
// `publishedAt IS NOT NULL` rows ordered by `order`. Per-trainer state lives
// in TrainerOnboardingStepProgress, joined by `key` (no FK so admins can
// rename keys without cascading through trainer history).
model OnboardingStep {
  id          String    @id @default(cuid())
  key         String    @unique
  order       Int       @default(0)
  title       String
  body        String    @db.Text
  ctaLabel    String
  ctaHref     String
  skippable   Boolean   @default(true)
  skipWarning String?   @db.Text
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("onboarding_steps")
}

// Admin-editable email template + send rule. The cron sender evaluates each
// published row's triggerRule against trainer state and dispatches via Resend.
// `senderKey` selects the founder voice ("karl" | "brooke") for from-address
// and signature.
model OnboardingEmail {
  id           String    @id @default(cuid())
  key          String    @unique
  subject      String
  body         String    @db.Text
  // Optional intro text shown ABOVE the hero image.
  topText      String?   @db.Text
  // Optional hero image shown in the email (admin-uploaded, public Blob URL).
  imageUrl     String?
  // Optional fixed display height for the image in px (null = natural/auto).
  imageHeight  Int?
  // Optional click-through link for the first image (wraps it in an <a href>).
  linkUrl      String?
  // Optional SECOND image block, shown below the body (admin-uploaded Blob URL).
  imageUrl2    String?
  imageHeight2 Int?
  // Optional click-through link for the second image.
  linkUrl2     String?
  // Optional THIRD text block, shown below the second image.
  bottomText   String?   @db.Text
  // Manual position within the admin "series" list (lower = earlier). Send
  // timing is still driven by triggerRule; this only controls list order.
  sortOrder    Int       @default(0)
  senderKey    String    @default("karl")
  // Examples:
  //   { "type": "on_signup" }
  //   { "type": "after_signup", "hours": 24, "requireStepIncomplete": "business_profile" }
  //   { "type": "after_first_invite_sent", "hours": 24, "requireNoClientSignedIn": true }
  //   { "type": "on_aha_reached" }
  triggerRule  Json
  publishedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("onboarding_emails")
}

// Trainer-owned, reusable email templates the trainer composes from when
// emailing clients (e.g. from the Messages composer). The body is sanitized
// rich-text HTML authored in the editor; subject/body support {{placeholders}}
// the composer resolves per recipient (e.g. {{clientName}}, {{trainerName}},
// {{businessName}}, {{dogName}}). `category` is an optional grouping label.
model EmailTemplate {
  id         String  @id @default(cuid())
  trainerId  String
  name       String
  category   String?
  // Set when this row OVERRIDES one of the platform's own emails (see
  // lib/system-emails.ts). Null = a reusable template the trainer wrote to
  // pick from when emailing a client by hand — the original use of this table.
  // One override per email per trainer; absent means "use the default".
  systemKey  String?
  // The body as EDITED — an ordered list of text and image blocks, the shape
  // components/shared/email-body-builder speaks. `body` above stays the HTML
  // that actually sends (serializeBlocks of this), because every sender reads
  // HTML and none of them should have to learn about blocks.
  //
  // Kept rather than parsed back out of the HTML: nothing can turn arbitrary
  // markup into blocks without losing something, and an editor that quietly
  // mangles what you saved is worse than no editor.
  bodyBlocks Json?
  subject    String  @db.Text
  body       String  @db.Text
  sortOrder  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainer    TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  // Forms configured to auto-reply with this template on submit.
  embedForms EmbedForm[]

  @@unique([trainerId, systemKey])
  @@index([trainerId, sortOrder])
  @@map("email_templates")
}

// One row per bulk email a trainer sends to a selection of their clients from
// the Clients-list composer. `subject`/`body` are the authored template (before
// per-recipient {{placeholder}} substitution). Recipients (one row each) hang
// off it for delivery tracking and to power the per-trainer daily send cap.
model EmailBroadcast {
  id             String @id @default(cuid())
  trainerId      String
  // The User (owner/staff) who composed and sent it.
  senderId       String
  subject        String @db.Text
  body           String @db.Text
  recipientCount Int    @default(0)

  createdAt DateTime @default(now())

  trainer    TrainerProfile            @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  recipients EmailBroadcastRecipient[]

  @@index([trainerId, createdAt])
  @@map("email_broadcasts")
}

// One row per recipient of a broadcast. `resendEmailId` is the id Resend returns
// for the sent message, used to map inbound delivery/open/click/bounce webhook
// events back to the row. `clientProfileId` is nullable so a later client delete
// doesn't orphan the send record.
model EmailBroadcastRecipient {
  id              String    @id @default(cuid())
  broadcastId     String
  clientProfileId String?
  email           String
  // Resend message id (from batch.send), unique so the webhook can upsert by it.
  resendEmailId   String?   @unique
  // SENT | DELIVERED | OPENED | CLICKED | BOUNCED | COMPLAINED | FAILED
  status          String    @default("SENT")
  openedAt        DateTime?
  clickedAt       DateTime?
  bouncedAt       DateTime?
  complainedAt    DateTime?

  createdAt DateTime @default(now())

  broadcast EmailBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@index([broadcastId])
  @@map("email_broadcast_recipients")
}

// One row per trainer, created on first dashboard load. ahaReachedAt fires
// when this trainer's first non-sample client signs in for the first time.
model TrainerOnboardingProgress {
  id                   String    @id @default(cuid())
  trainerId            String    @unique
  startedAt            DateTime  @default(now())
  ahaReachedAt         DateTime?
  // Timestamp of the trainer's first sent client invite — anchors the
  // chase-sequence drips (emails 3 and 4).
  firstInviteSentAt    DateTime?
  // Trainer dismissed the dashboard checklist widget independently of completion.
  checklistDismissedAt DateTime?
  // Set on the row when it was created via post-deploy backfill (trainer
  // existed before onboarding shipped). Suppresses auto-modal — instead the
  // dashboard shows a one-time opt-in banner. Null = fresh signup.
  backfilledAt         DateTime?
  // Set when the trainer dismissed the first-visit welcome modal — either by
  // clicking "Start the quick setup" or "Skip". Once set, the welcome never
  // shows again (the wizard / checklist take over).
  welcomeShownAt       DateTime?
  // Set ONLY when the trainer explicitly opts into the tour — either by
  // clicking "Start the quick setup" on the welcome modal or "Take the
  // tour" on the backfill banner. Skip / No thanks do NOT set this.
  // Gates the floating onboarding FAB and the pulsing menu/in-page dots
  // — those are tour-only nudges, so before opt-in nothing should fire.
  tourStartedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainer TrainerProfile                  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  steps   TrainerOnboardingStepProgress[]
  emails  TrainerOnboardingEmailLog[]

  @@map("trainer_onboarding_progress")
}

// Per-trainer per-step state. `stepKey` is denormalised — no FK to
// OnboardingStep so admins can rename/delete steps without orphaning trainers.
model TrainerOnboardingStepProgress {
  id          String    @id @default(cuid())
  progressId  String
  stepKey     String
  startedAt   DateTime?
  completedAt DateTime?
  skippedAt   DateTime?

  progress TrainerOnboardingProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  @@unique([progressId, stepKey])
  @@index([progressId])
  @@map("trainer_onboarding_step_progress")
}

// Idempotency log — `@@unique([progressId, emailKey])` prevents the cron
// sender from resending the same drip to the same trainer.
model TrainerOnboardingEmailLog {
  id         String   @id @default(cuid())
  progressId String
  emailKey   String
  sentAt     DateTime @default(now())

  progress TrainerOnboardingProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  @@unique([progressId, emailKey])
  @@index([progressId])
  @@map("trainer_onboarding_email_logs")
}

// ─── Rate limiting ─────────────────────────────────────────────────────────
// Fixed-window counters for abuse control on sensitive/unauthenticated
// endpoints (login, register, password reset, public form submit). One row per
// rate-limit key (e.g. "login:1.2.3.4"); updated via an atomic upsert in
// src/lib/rate-limit.ts. resetAt marks when the window rolls over. Stale rows
// are harmless (overwritten on next hit for that key); the index supports an
// optional periodic prune.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
  @@map("rate_limits")
}

// Append-only audit trail for sensitive actions. Written ONLY by the trusted
// server helper recordAudit() (src/lib/audit.ts); the app never updates or
// deletes rows, and reads are gated to the owning company's OWNER or a platform
// ADMIN. Deliberately has NO foreign keys — ids are stored as plain strings so
// the trail survives deletion of the user/company it describes (forensics).
// meta must NEVER contain secrets, tokens, reset links, OTPs, or passwords.
enum AuditAction {
  USER_SIGNUP
  USER_LOGIN
  USER_LOGIN_FAILED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_CHANGED
  ROLE_CHANGED
  PERMISSIONS_CHANGED
  INVITE_CREATED
  INVITE_ACCEPTED
  MEMBER_REMOVED
  BILLING_CHANGED
  PAYMENTS_TOGGLED
  DATA_EXPORTED
  ACCOUNT_DELETION_REQUESTED
  ACCOUNT_DELETED
  ADMIN_ACTION
}

model AuditLog {
  id          String      @id @default(cuid())
  // The business this event belongs to, for scoping reads. Null for pre-tenant
  // events (signup, failed login before a company is resolved).
  companyId   String?
  // Who performed it (User.id). Null for anonymous / failed-auth events.
  actorUserId String?
  action      AuditAction
  // What it acted on — free-form ("membership", "user", "payment") + its id.
  targetType  String?
  targetId    String?
  ip          String?
  userAgent   String?
  // Extra structured, non-sensitive context.
  meta        Json?
  createdAt   DateTime    @default(now())

  @@index([companyId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

// ─── Dashboard scratchpad: Brain dump + To-dos ────────────────────────────────
// Per-trainer dashboard right-rail. The brain dump is a single freeform note per
// (company, user) that autosaves. To-dos are shared across the company and can
// be assigned to a team member when the org has more than one trainer.

// One freeform note per (company, user). Autosaves (debounced) from the
// dashboard panel; scoped to the logged-in user so each trainer has their own.
model TrainerBrainDump {
  id        String   @id @default(cuid())
  companyId String // → TrainerProfile.id (the business / tenant)
  userId    String // → User.id (whose brain dump this is)
  body      String   @default("") @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company TrainerProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@map("trainer_brain_dumps")
}

// A shared company to-do. Created by a trainer; optionally assigned to a team
// member (TrainerMembership) when the org has more than one trainer. assignedTo
// is SetNull so removing a member leaves their to-dos intact but unassigned.
model TrainerTodo {
  id           String    @id @default(cuid())
  companyId    String // → TrainerProfile.id (the business / tenant)
  title        String
  done         Boolean   @default(false)
  createdById  String // → User.id (who created it)
  assignedToId String? // → TrainerMembership.id (who it's assigned to)
  dueDate      DateTime?
  sortOrder    Int       @default(0)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company    TrainerProfile     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy  User               @relation("TodoCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  assignedTo TrainerMembership? @relation("TodoAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@map("trainer_todos")
}

/// A note Karl left on a real screen, pinned to the element it points at.
///
/// Backs the in-app review widget (ported from fm-events). Deliberately NOT tied
/// to a trainer or a company: this is a build tool, one reviewer, and scoping it
/// to a tenant would mean a note left while impersonating a customer belonged to
/// that customer.
model ReviewComment {
  id String @id @default(cuid())

  /// The route with record ids replaced ("/clients/:id"), plus ?tab= when a tab
  /// selects the view. A pin left on one client's screen is a note about THAT
  /// SCREEN, not about that client — see pageKeyFor in lib/review-target.
  pageKey String

  /// The comment's PERMANENT number on its page. Assigned once and never reused,
  /// so resolving one comment can't renumber the rest — "pin 7" means the same
  /// thing tomorrow.
  seq Int?

  body       String  @db.Text
  authorName String?

  /// Pin position in the scrolling content, null for a page-level note. Kept as
  /// the fallback for when the captured element can no longer be found.
  x Float?
  y Float?

  /// The captured ReviewTarget (lib/review-target). Held as Json rather than
  /// mirrored columns ON PURPOSE: the capture module is deliberately standalone
  /// so it can be lifted elsewhere, and re-declaring its fields here would make
  /// it two things to keep in step. A comment must survive a capture from a
  /// newer or older client either way.
  context Json?

  /// Images dropped on the comment — screenshots, mock-ups, references. Each is
  /// `{ path, name }` where path is repo-relative, so an agent can Read the file
  /// rather than only look at a link.
  attachments Json?

  /// Approved by Karl as real work. Only ready comments reach an agent — a
  /// comment nobody has approved is a suggestion, and the gate is enforced
  /// server-side, not by the client's selection.
  ready   Boolean   @default(false)
  readyAt DateTime?

  /// Handed to an agent in a brief. Lets the panel show "sent, not started"
  /// instead of it looking identical to untouched work.
  queuedAt DateTime?

  /// The agent's own state on this item: 'done' (built, awaiting sign-off) or
  /// 'needs_info' (a question is on the comment). Never resolves it — Karl signs
  /// off himself.
  claudeStatus String?
  claudeNote   String?   @db.Text
  claudeAt     DateTime?

  /// Karl's sign-off. A resolved comment leaves the board.
  resolved   Boolean   @default(false)
  resolvedAt DateTime?

  /// A reply hangs off its parent rather than becoming a task of its own.
  parentId String?
  parent   ReviewComment?  @relation("ReviewReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  ReviewComment[] @relation("ReviewReplies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageKey])
  @@index([resolved])
  @@index([parentId])
  @@map("review_comments")
}
